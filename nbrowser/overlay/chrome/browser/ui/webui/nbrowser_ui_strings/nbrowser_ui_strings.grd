<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared bundle for small NBrowser-authored UI strings (buttons, toggles,
     labels) added across existing upstream WebUI surfaces - e.g. the
     Customize NBrowser color picker's exact-hex dialog. Kept separate from
     chrome/app/generated_resources.grd (upstream-owned, changes constantly,
     high rebase-conflict risk) so new NBrowser strings never collide with
     upstream. Reserve a new dedicated .grd per surface only for large
     standalone features with their own directory (see
     nbrowser_first_run_strings.grd); everything else - a handful of strings
     scattered across several existing files - belongs in this shared file. -->

<grit base_dir="." latest_public_release="0" current_release="1"
      source_lang_id="en" enc_check="möl">
  <outputs>
    <output filename="grit/nbrowser_ui_strings.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="nbrowser_ui_strings_af.pak" type="data_package" lang="af" />
    <output filename="nbrowser_ui_strings_am.pak" type="data_package" lang="am" />
    <output filename="nbrowser_ui_strings_ar.pak" type="data_package" lang="ar" />
    <output filename="nbrowser_ui_strings_as.pak" type="data_package" lang="as" />
    <output filename="nbrowser_ui_strings_az.pak" type="data_package" lang="az" />
    <output filename="nbrowser_ui_strings_be.pak" type="data_package" lang="be" />
    <output filename="nbrowser_ui_strings_bg.pak" type="data_package" lang="bg" />
    <output filename="nbrowser_ui_strings_bn.pak" type="data_package" lang="bn" />
    <output filename="nbrowser_ui_strings_bs.pak" type="data_package" lang="bs" />
    <output filename="nbrowser_ui_strings_ca.pak" type="data_package" lang="ca" />
    <output filename="nbrowser_ui_strings_cs.pak" type="data_package" lang="cs" />
    <output filename="nbrowser_ui_strings_cy.pak" type="data_package" lang="cy" />
    <output filename="nbrowser_ui_strings_da.pak" type="data_package" lang="da" />
    <output filename="nbrowser_ui_strings_de.pak" type="data_package" lang="de" />
    <output filename="nbrowser_ui_strings_el.pak" type="data_package" lang="el" />
    <output filename="nbrowser_ui_strings_en-GB.pak" type="data_package" lang="en-GB" />
    <output filename="nbrowser_ui_strings_en-US.pak" type="data_package" lang="en" />
    <output filename="nbrowser_ui_strings_es.pak" type="data_package" lang="es" />
    <output filename="nbrowser_ui_strings_es-419.pak" type="data_package" lang="es-419" />
    <output filename="nbrowser_ui_strings_et.pak" type="data_package" lang="et" />
    <output filename="nbrowser_ui_strings_eu.pak" type="data_package" lang="eu" />
    <output filename="nbrowser_ui_strings_fa.pak" type="data_package" lang="fa" />
    <output filename="nbrowser_ui_strings_fi.pak" type="data_package" lang="fi" />
    <output filename="nbrowser_ui_strings_fil.pak" type="data_package" lang="fil" />
    <output filename="nbrowser_ui_strings_fr-CA.pak" type="data_package" lang="fr-CA" />
    <output filename="nbrowser_ui_strings_fr.pak" type="data_package" lang="fr" />
    <output filename="nbrowser_ui_strings_gl.pak" type="data_package" lang="gl" />
    <output filename="nbrowser_ui_strings_gu.pak" type="data_package" lang="gu" />
    <output filename="nbrowser_ui_strings_he.pak" type="data_package" lang="he" />
    <output filename="nbrowser_ui_strings_hi.pak" type="data_package" lang="hi" />
    <output filename="nbrowser_ui_strings_hr.pak" type="data_package" lang="hr" />
    <output filename="nbrowser_ui_strings_hu.pak" type="data_package" lang="hu" />
    <output filename="nbrowser_ui_strings_hy.pak" type="data_package" lang="hy" />
    <output filename="nbrowser_ui_strings_id.pak" type="data_package" lang="id" />
    <output filename="nbrowser_ui_strings_is.pak" type="data_package" lang="is" />
    <output filename="nbrowser_ui_strings_it.pak" type="data_package" lang="it" />
    <output filename="nbrowser_ui_strings_ja.pak" type="data_package" lang="ja" />
    <output filename="nbrowser_ui_strings_ka.pak" type="data_package" lang="ka" />
    <output filename="nbrowser_ui_strings_kk.pak" type="data_package" lang="kk" />
    <output filename="nbrowser_ui_strings_km.pak" type="data_package" lang="km" />
    <output filename="nbrowser_ui_strings_kn.pak" type="data_package" lang="kn" />
    <output filename="nbrowser_ui_strings_ko.pak" type="data_package" lang="ko" />
    <output filename="nbrowser_ui_strings_ky.pak" type="data_package" lang="ky" />
    <output filename="nbrowser_ui_strings_lo.pak" type="data_package" lang="lo" />
    <output filename="nbrowser_ui_strings_lt.pak" type="data_package" lang="lt" />
    <output filename="nbrowser_ui_strings_lv.pak" type="data_package" lang="lv" />
    <output filename="nbrowser_ui_strings_mk.pak" type="data_package" lang="mk" />
    <output filename="nbrowser_ui_strings_ml.pak" type="data_package" lang="ml" />
    <output filename="nbrowser_ui_strings_mn.pak" type="data_package" lang="mn" />
    <output filename="nbrowser_ui_strings_mr.pak" type="data_package" lang="mr" />
    <output filename="nbrowser_ui_strings_ms.pak" type="data_package" lang="ms" />
    <output filename="nbrowser_ui_strings_my.pak" type="data_package" lang="my" />
    <output filename="nbrowser_ui_strings_ne.pak" type="data_package" lang="ne" />
    <output filename="nbrowser_ui_strings_nl.pak" type="data_package" lang="nl" />
    <output filename="nbrowser_ui_strings_nb.pak" type="data_package" lang="no" />
    <output filename="nbrowser_ui_strings_pa.pak" type="data_package" lang="pa" />
    <output filename="nbrowser_ui_strings_pl.pak" type="data_package" lang="pl" />
    <output filename="nbrowser_ui_strings_pt-BR.pak" type="data_package" lang="pt-BR" />
    <output filename="nbrowser_ui_strings_pt-PT.pak" type="data_package" lang="pt-PT" />
    <output filename="nbrowser_ui_strings_or.pak" type="data_package" lang="or" />
    <output filename="nbrowser_ui_strings_ro.pak" type="data_package" lang="ro" />
    <output filename="nbrowser_ui_strings_ru.pak" type="data_package" lang="ru" />
    <output filename="nbrowser_ui_strings_si.pak" type="data_package" lang="si" />
    <output filename="nbrowser_ui_strings_sk.pak" type="data_package" lang="sk" />
    <output filename="nbrowser_ui_strings_sl.pak" type="data_package" lang="sl" />
    <output filename="nbrowser_ui_strings_sq.pak" type="data_package" lang="sq" />
    <output filename="nbrowser_ui_strings_sr-Latn.pak" type="data_package" lang="sr-Latn" />
    <output filename="nbrowser_ui_strings_sr.pak" type="data_package" lang="sr" />
    <output filename="nbrowser_ui_strings_sv.pak" type="data_package" lang="sv" />
    <output filename="nbrowser_ui_strings_sw.pak" type="data_package" lang="sw" />
    <output filename="nbrowser_ui_strings_ta.pak" type="data_package" lang="ta" />
    <output filename="nbrowser_ui_strings_te.pak" type="data_package" lang="te" />
    <output filename="nbrowser_ui_strings_th.pak" type="data_package" lang="th" />
    <output filename="nbrowser_ui_strings_tr.pak" type="data_package" lang="tr" />
    <output filename="nbrowser_ui_strings_uk.pak" type="data_package" lang="uk" />
    <output filename="nbrowser_ui_strings_ur.pak" type="data_package" lang="ur" />
    <output filename="nbrowser_ui_strings_uz.pak" type="data_package" lang="uz" />
    <output filename="nbrowser_ui_strings_vi.pak" type="data_package" lang="vi" />
    <output filename="nbrowser_ui_strings_zh-CN.pak" type="data_package" lang="zh-CN" />
    <output filename="nbrowser_ui_strings_zh-HK.pak" type="data_package" lang="zh-HK" />
    <output filename="nbrowser_ui_strings_zh-TW.pak" type="data_package" lang="zh-TW" />
    <output filename="nbrowser_ui_strings_zu.pak" type="data_package" lang="zu" />

    <!-- Pseudolocales -->
    <output filename="nbrowser_ui_strings_ar-XB.pak" type="data_package" lang="ar-XB" />
    <output filename="nbrowser_ui_strings_en-XA.pak" type="data_package" lang="en-XA" />
  </outputs>

  <translations>
    <!-- English is the source language and needs no entry here. Every other
         locale listed in <outputs> above that isn't listed here falls back
         to the English source text at build time, because of
         fallback_to_english="true" below. -->
    <file path="translations/nbrowser_ui_strings_ru.xtb" lang="ru" />
    <file path="translations/nbrowser_ui_strings_es.xtb" lang="es" />
    <file path="translations/nbrowser_ui_strings_fr.xtb" lang="fr" />
    <file path="translations/nbrowser_ui_strings_zh-CN.xtb" lang="zh-CN" />
    <file path="translations/nbrowser_ui_strings_de.xtb" lang="de" />
  </translations>

  <release seq="1">
    <messages fallback_to_english="true">
      <!-- Customize NBrowser color picker: exact-hex custom colors dialog. -->
      <message name="IDS_NTP_CUSTOMIZE_COLOR_HEX_DIALOG_TITLE" desc="The title for the dialog that lets a user pick independent exact primary, secondary and accent colors for their theme.">
        Custom colors
      </message>
      <message name="IDS_NTP_CUSTOMIZE_COLOR_HEX_PRIMARY_LABEL" desc="The label for the primary color hex input field in the custom colors dialog.">
        Primary color
      </message>
      <message name="IDS_NTP_CUSTOMIZE_COLOR_HEX_SECONDARY_LABEL" desc="The label for the secondary color hex input field in the custom colors dialog.">
        Secondary color
      </message>
      <message name="IDS_NTP_CUSTOMIZE_COLOR_HEX_ACCENT_LABEL" desc="The label for the accent color hex input field in the custom colors dialog.">
        Accent color
      </message>
      <message name="IDS_NTP_CUSTOMIZE_COLOR_HEX_INVALID_ERROR" desc="Error text shown below a hex color input field when the entered text is not a valid 6-digit hex color.">
        Enter a valid hex color, e.g. #000000
      </message>
      <message name="IDS_NTP_CUSTOMIZE_COLOR_SAVED_PRESET_NAME" desc="Title/accessibility label for a user-saved custom primary/secondary/accent color preset swatch in the customization menu.">
        Saved color
      </message>
      <message name="IDS_NTP_CUSTOMIZE_COLOR_DELETE_SAVED_PRESET_LABEL" desc="Accessibility label and tooltip for the button that deletes a user-saved custom color preset.">
        Remove saved color
      </message>
      <message name="IDS_NTP_CUSTOMIZE_SAVE_PRESET_BUTTON" desc="Label for the button that saves the current custom primary/secondary/accent colors as a new reusable preset.">
        Save Preset
      </message>

      <!-- NBrowser GitHub Releases update infobar (chrome/browser/ui/startup/nbrowser_update_infobar_delegate.cc). No <ph> placeholder here on purpose - the project's translation fingerprint tooling (fix_branding_translations.py / check_nbrowser_translations.py) can't reliably recompute grit's real id for placeholder-bearing messages (see NBrowser_Localization_Guide.md section 2's "Ограничение"), so NBrowser-authored strings in this shared bundle stay plain text. -->
      <message name="IDS_NBROWSER_UPDATE_AVAILABLE_INFOBAR_TEXT" desc="Text shown in the infobar offering to update NBrowser to a newer version found on GitHub Releases.">
        A new version of NBrowser is available.
      </message>
      <message name="IDS_NBROWSER_UPDATE_AVAILABLE_INFOBAR_BUTTON_LABEL" desc="Label of the button in the NBrowser update infobar that downloads and launches the new version's installer.">
        Update
      </message>
      <message name="IDS_NBROWSER_UPDATE_INSTALLER_LAUNCH_FAILED" desc="Status message on chrome://settings/help when downloading or launching the update installer fails.">
        Couldn't download the update. Try again later.
      </message>
      <message name="IDS_NBROWSER_UPDATE_AVAILABLE_ABOUT_PAGE_TEXT" desc="Status message on chrome://settings/help when a newer version was found but 'auto-update' is off, so nothing was downloaded automatically - points the user at the infobar that was just shown instead.">
        A new version of NBrowser is available. Look for the notification at the top of the window to install it.
      </message>
      <message name="IDS_NBROWSER_UPDATE_AUTO_INSTALL_TOGGLE_LABEL" desc="Label for the toggle on chrome://settings/help that controls whether NBrowser installs updates automatically or asks first.">
        Allow NBrowser to update automatically
      </message>
      <message name="IDS_NBROWSER_UPDATE_AUTO_INSTALL_TOGGLE_SUB_LABEL" desc="Sub-label under the auto-update toggle on chrome://settings/help, explaining what turning it off does.">
        When off, you'll be asked before each update is installed.
      </message>

      <!-- Quick Translate context-menu preview row (chrome/browser/quick_translate/, chrome/browser/ui/views/renderer_context_menu/quick_translate_menu_view.h). No <ph> placeholders on purpose, same reason as the update infobar strings above - dynamic language names/translated text are composed directly in C++, not via message substitution. -->
      <message name="IDS_QUICK_TRANSLATE_PREPARING" desc="Status text shown in the Quick Translate context-menu row while the local translation engine is starting up.">
        Preparing translation…
      </message>
      <message name="IDS_QUICK_TRANSLATE_UNAVAILABLE" desc="Status text shown in the Quick Translate context-menu row when translation failed for an unspecified reason.">
        Translation unavailable
      </message>
      <message name="IDS_QUICK_TRANSLATE_UNSUPPORTED_LANGUAGE" desc="Status text shown in the Quick Translate context-menu row when the detected or target language isn't supported by the local engine.">
        Translation not available for this language
      </message>
      <message name="IDS_QUICK_TRANSLATE_ALREADY_TRANSLATED" desc="Status text shown in the Quick Translate context-menu row when the selected text is already in the user's configured target language.">
        Already in this language
      </message>
      <message name="IDS_QUICK_TRANSLATE_NO_CONNECTION" desc="Status text shown in the Quick Translate context-menu row when the online model is enabled but unreachable and the local engine can't cover the needed language pair either.">
        No connection
      </message>

      <!-- Quick Translate settings block, chrome://settings/languages between the Spell check and Translate cards (chrome/browser/resources/settings/languages_page/translate_page.html, chrome/browser/quick_translate/quick_translate_prefs.h). -->
      <message name="IDS_QUICK_TRANSLATE_PAGE_TITLE" desc="Title of the standalone Quick Translate settings card on chrome://settings/languages, positioned between the Spell check and Translate cards.">
        Quick Translate
      </message>
      <message name="IDS_QUICK_TRANSLATE_SETTINGS_ENABLED_LABEL" desc="Label for the master settings toggle that turns the whole Quick Translate context-menu feature on or off; the two model-choice toggles below it are only enabled when this is on.">
        Use Quick Translate
      </message>
      <message name="IDS_QUICK_TRANSLATE_SETTINGS_ENABLED_SUBLABEL" desc="Sub-label under the master Quick Translate settings toggle, describing the feature in general terms (the specific offline/online model choice has its own toggles below).">
        Show a quick translation of selected text in the right-click menu
      </message>
      <message name="IDS_QUICK_TRANSLATE_SETTINGS_USE_OFFLINE_MODEL_LABEL" desc="Label for the settings toggle that lets Quick Translate use the on-device engine, one of the two model-choice toggles under the master Quick Translate toggle.">
        Use offline model for Quick Translate
      </message>
      <message name="IDS_QUICK_TRANSLATE_SETTINGS_USE_OFFLINE_MODEL_SUBLABEL" desc="Sub-label under the offline-model settings toggle, explaining it runs fully on-device and which language pair the bundled model covers.">
        Doesn't require an internet connection - uses a local language model (English to Russian only)
      </message>
      <message name="IDS_QUICK_TRANSLATE_SETTINGS_USE_ONLINE_MODEL_LABEL" desc="Label for the settings toggle that lets Quick Translate try Google's online translation API first, before falling back to the local engine.">
        Use an online model for Quick Translate
      </message>
      <message name="IDS_QUICK_TRANSLATE_SETTINGS_USE_ONLINE_MODEL_SUBLABEL" desc="Sub-label under the online-model settings toggle, disclosing that it sends data to Google. 'when available' also covers the automatic fallback to the local engine when the online API is unreachable.">
        Uses Google's API when available to improve quality (sends data to Google)
      </message>
    </messages>
  </release>
</grit>
