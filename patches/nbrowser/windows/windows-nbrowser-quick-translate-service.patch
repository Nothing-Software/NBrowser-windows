+# Copyright 2026 The NBrowser Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//components/on_device_translation/buildflags/features.gni")
+
+assert(enable_on_device_translation)
+
+# Split out of :quick_translate so that code outside this feature (e.g.
+# chrome/browser/extensions/api/settings_private, which needs the pref
+# names for its settingsPrivate allowlist) can depend on just the pref
+# names without pulling in the full feature - :quick_translate transitively
+# depends on //chrome/browser/on_device_translation, which itself
+# transitively depends back on //chrome/browser/extensions, so a direct
+# extensions -> quick_translate dependency is a GN dependency cycle.
+source_set("prefs") {
+  sources = [
+    "quick_translate_prefs.cc",
+    "quick_translate_prefs.h",
+  ]
+  deps = [ "//components/pref_registry" ]
+  configs += [ "//build/config/compiler:wexit_time_destructors" ]
+}
+
+source_set("quick_translate") {
+  sources = [
+    "fallback_quick_translate_provider.cc",
+    "fallback_quick_translate_provider.h",
+    "local_quick_translate_provider.cc",
+    "local_quick_translate_provider.h",
+    "quick_translate_provider.h",
+    "quick_translate_request.cc",
+    "quick_translate_request.h",
+    "quick_translate_service.cc",
+    "quick_translate_service.h",
+    "quick_translate_service_factory.cc",
+    "quick_translate_service_factory.h",
+    "remote_quick_translate_provider.cc",
+    "remote_quick_translate_provider.h",
+  ]
+  public_deps = [
+    "//chrome/browser:browser_public_dependencies",
+    "//components/on_device_translation:public",
+  ]
+  deps = [
+    ":prefs",
+    "//base",
+    "//chrome/browser/language",
+    "//chrome/browser/language_detection",
+    "//chrome/browser/on_device_translation",
+    "//chrome/browser/translate",
+    "//components/keyed_service/content",
+    "//components/language/core/browser",
+    "//components/language_detection/core",
+    "//components/on_device_translation/public/mojom",
+    "//components/prefs",
+    "//components/translate/core/browser",
+    "//mojo/public/cpp/bindings",
+    "//net",
+    "//services/network/public/cpp",
+    "//url",
+  ]
+  configs += [ "//build/config/compiler:wexit_time_destructors" ]
+}
diff --git a/chrome/browser/quick_translate/fallback_quick_translate_provider.cc b/chrome/browser/quick_translate/fallback_quick_translate_provider.cc
new file mode 100644
index 0000000000..cdffd4f90a
--- /dev/null
+++ b/chrome/browser/quick_translate/fallback_quick_translate_provider.cc
@@ -0,0 +1,127 @@
+// Copyright 2026 The NBrowser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/quick_translate/fallback_quick_translate_provider.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/time/time.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/quick_translate/quick_translate_prefs.h"
+#include "components/prefs/pref_service.h"
+
+namespace quick_translate {
+
+namespace {
+constexpr base::TimeDelta kOnlineCooldown = base::Minutes(5);
+}  // namespace
+
+FallbackQuickTranslateProvider::FallbackQuickTranslateProvider(
+    Profile* profile)
+    : profile_(profile), local_(profile), remote_(profile) {}
+
+FallbackQuickTranslateProvider::~FallbackQuickTranslateProvider() = default;
+
+bool FallbackQuickTranslateProvider::IsReady() const {
+  return local_.IsReady();
+}
+
+void FallbackQuickTranslateProvider::Translate(const std::u16string& text,
+                                               ResultCallback callback) {
+  PrefService* pref_service = profile_->GetPrefs();
+  const bool offline_enabled =
+      pref_service->GetBoolean(prefs::kQuickTranslateUseOfflineModel);
+  const bool online_enabled =
+      pref_service->GetBoolean(prefs::kQuickTranslateUseOnlineModel);
+
+  if (!offline_enabled && !online_enabled) {
+    Result result;
+    result.status = Status::kError;
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+
+  if (online_enabled && !InOnlineCooldown()) {
+    remote_.Translate(
+        text, local_.GetTargetLanguage(),
+        base::BindOnce(&FallbackQuickTranslateProvider::OnRemoteResult,
+                       weak_ptr_factory_.GetWeakPtr(), text, offline_enabled,
+                       std::move(callback)));
+    return;
+  }
+
+  if (offline_enabled) {
+    if (online_enabled) {
+      // Online is wanted but cooling down after a recent failure - route
+      // through the same "local can't cover this pair" -> kNoConnection
+      // remap a live failure would, since the underlying reason is the same.
+      TranslateLocallyAsFallback(text, std::move(callback));
+    } else {
+      local_.Translate(text, std::move(callback));
+    }
+    return;
+  }
+
+  // Online is wanted but cooling down, and offline is disabled - nothing
+  // usable right now.
+  Result result;
+  result.status = Status::kNoConnection;
+  std::move(callback).Run(std::move(result));
+}
+
+bool FallbackQuickTranslateProvider::InOnlineCooldown() const {
+  return remote_cooldown_until_ &&
+        base::TimeTicks::Now() < *remote_cooldown_until_;
+}
+
+void FallbackQuickTranslateProvider::TranslateLocallyAsFallback(
+    const std::u16string& text,
+    ResultCallback callback) {
+  local_.Translate(
+      text, base::BindOnce(
+                &FallbackQuickTranslateProvider::OnLocalFallbackResult,
+                weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void FallbackQuickTranslateProvider::OnRemoteResult(std::u16string text,
+                                                    bool offline_enabled,
+                                                    ResultCallback callback,
+                                                    Result result) {
+  if (result.status != Status::kError) {
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+
+  // Most commonly means "no network" - stop trying the remote provider for
+  // a while rather than paying for another doomed round-trip on every
+  // translation until then.
+  remote_cooldown_until_ = base::TimeTicks::Now() + kOnlineCooldown;
+
+  if (offline_enabled) {
+    TranslateLocallyAsFallback(text, std::move(callback));
+    return;
+  }
+
+  // Offline is disabled, so there is no fallback to try.
+  Result out;
+  out.status = Status::kNoConnection;
+  std::move(callback).Run(std::move(out));
+}
+
+void FallbackQuickTranslateProvider::OnLocalFallbackResult(
+    ResultCallback callback,
+    Result result) {
+  // The local engine only covers en<->ru. Reaching for the remote provider
+  // in the first place already implied that pair wasn't enough, so the
+  // local engine reporting "unsupported language" here really means the
+  // remote attempt that just failed had no local equivalent to fall back
+  // on - i.e. no connection, not a permanent limitation of this pair.
+  if (result.status == Status::kUnsupportedLanguage) {
+    result.status = Status::kNoConnection;
+  }
+  std::move(callback).Run(std::move(result));
+}
+
+}  // namespace quick_translate
diff --git a/chrome/browser/quick_translate/fallback_quick_translate_provider.h b/chrome/browser/quick_translate/fallback_quick_translate_provider.h
new file mode 100644
index 0000000000..55511bde44
--- /dev/null
+++ b/chrome/browser/quick_translate/fallback_quick_translate_provider.h
@@ -0,0 +1,84 @@
+// Copyright 2026 The NBrowser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_QUICK_TRANSLATE_FALLBACK_QUICK_TRANSLATE_PROVIDER_H_
+#define CHROME_BROWSER_QUICK_TRANSLATE_FALLBACK_QUICK_TRANSLATE_PROVIDER_H_
+
+#include <optional>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "chrome/browser/quick_translate/local_quick_translate_provider.h"
+#include "chrome/browser/quick_translate/quick_translate_provider.h"
+#include "chrome/browser/quick_translate/remote_quick_translate_provider.h"
+
+class Profile;
+
+namespace quick_translate {
+
+// The QuickTranslateProvider QuickTranslateService actually installs.
+// Composes the two independently-toggleable engines
+// (prefs::kQuickTranslateUseOfflineModel, prefs::kQuickTranslateUseOnlineModel
+// - both surfaced as sub-toggles under the master "Use Quick Translate" one):
+// with both on, tries RemoteQuickTranslateProvider first, for its wider
+// language coverage, and falls back to the on-device engine whenever the
+// remote attempt fails - most commonly, no network connection. With only one
+// on, that engine is used directly and the other is never invoked, even as a
+// fallback - an explicitly disabled engine stays disabled. With neither on,
+// Translate() fails immediately without attempting anything.
+//
+// A failed remote attempt disables further remote attempts for
+// kOnlineCooldown, so that an offline user doesn't pay for (and wait out) a
+// doomed network round-trip on every single translation.
+class FallbackQuickTranslateProvider : public QuickTranslateProvider {
+ public:
+  explicit FallbackQuickTranslateProvider(Profile* profile);
+  ~FallbackQuickTranslateProvider() override;
+
+  FallbackQuickTranslateProvider(const FallbackQuickTranslateProvider&) =
+      delete;
+  FallbackQuickTranslateProvider& operator=(
+      const FallbackQuickTranslateProvider&) = delete;
+
+  // QuickTranslateProvider:
+  void Translate(const std::u16string& text,
+                 ResultCallback callback) override;
+  bool IsReady() const override;
+
+ private:
+  bool InOnlineCooldown() const;
+
+  // Routes through OnLocalFallbackResult so a language the local engine
+  // can't cover is reported as kNoConnection rather than
+  // kUnsupportedLanguage - correct here because online was wanted (either
+  // it was just tried and failed, or it's being skipped for
+  // InOnlineCooldown()), so "local can't do this pair" really does mean
+  // "the online model that could have is currently unavailable".
+  void TranslateLocallyAsFallback(const std::u16string& text,
+                                  ResultCallback callback);
+
+  void OnRemoteResult(std::u16string text,
+                      bool offline_enabled,
+                      ResultCallback callback,
+                      Result result);
+  void OnLocalFallbackResult(ResultCallback callback, Result result);
+
+  raw_ptr<Profile> profile_;
+  LocalQuickTranslateProvider local_;
+  RemoteQuickTranslateProvider remote_;
+
+  // Unset until the first remote failure - see the class comment for why
+  // remote attempts are throttled after a failure rather than retried on
+  // every translation.
+  std::optional<base::TimeTicks> remote_cooldown_until_;
+
+  base::WeakPtrFactory<FallbackQuickTranslateProvider> weak_ptr_factory_{
+      this};
+};
+
+}  // namespace quick_translate
+
+#endif  // CHROME_BROWSER_QUICK_TRANSLATE_FALLBACK_QUICK_TRANSLATE_PROVIDER_H_
diff --git a/chrome/browser/quick_translate/local_quick_translate_provider.cc b/chrome/browser/quick_translate/local_quick_translate_provider.cc
new file mode 100644
index 0000000000..0f89cf8371
--- /dev/null
+++ b/chrome/browser/quick_translate/local_quick_translate_provider.cc
@@ -0,0 +1,201 @@
+// Copyright 2026 The NBrowser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/quick_translate/local_quick_translate_provider.h"
+
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/language/language_model_manager_factory.h"
+#include "chrome/browser/language_detection/language_detection_model_service_factory.h"
+#include "components/language/core/browser/language_model_manager.h"
+#include "chrome/browser/on_device_translation/service_controller_manager_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/translate/chrome_translate_client.h"
+#include "components/language_detection/core/language_detection_model.h"
+#include "components/language_detection/core/language_detection_provider.h"
+#include "components/on_device_translation/features.h"
+#include "components/on_device_translation/public/mojom/translator.mojom.h"
+#include "components/on_device_translation/service_controller_manager.h"
+#include "components/translate/core/browser/translate_manager.h"
+#include "components/translate/core/browser/translate_prefs.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace quick_translate {
+
+namespace {
+
+// Used only as a cache key into ServiceControllerManager's per-origin LRU of
+// translators (and for its content-setting storage) - it is not tied to any
+// real site, so a single stable value keeps the translator cache warm across
+// every page the user quick-translates from, rather than thrashing one entry
+// per visited origin. See components/on_device_translation/
+// service_controller_manager.h.
+const url::Origin& QuickTranslateOrigin() {
+  static const base::NoDestructor<url::Origin> origin(
+      url::Origin::Create(GURL("chrome://quick-translate")));
+  return *origin;
+}
+
+}  // namespace
+
+LocalQuickTranslateProvider::LocalQuickTranslateProvider(Profile* profile)
+    : profile_(profile) {}
+
+LocalQuickTranslateProvider::~LocalQuickTranslateProvider() = default;
+
+bool LocalQuickTranslateProvider::IsReady() const {
+  // Reflects whether the local TranslateKit engine/language packs bundled
+  // with this install were wired up (see the NBrowser addition to
+  // ChromeMainDelegate::BasicStartupComplete() in chrome_main_delegate.cc) -
+  // component-updater-based auto-download is unconditionally disabled by
+  // ungoogled-chromium's block-requests.patch, so this switch is the only
+  // way the engine ever becomes available.
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      on_device_translation::kTranslateKitBinaryPath);
+}
+
+std::string LocalQuickTranslateProvider::GetTargetLanguage() const {
+  std::unique_ptr<translate::TranslatePrefs> translate_prefs =
+      ChromeTranslateClient::CreateTranslatePrefs(profile_->GetPrefs());
+  language::LanguageModel* language_model =
+      LanguageModelManagerFactory::GetForBrowserContext(profile_)
+          ->GetPrimaryModel();
+  return translate::TranslateManager::GetTargetLanguage(translate_prefs.get(),
+                                                        language_model);
+}
+
+void LocalQuickTranslateProvider::Translate(const std::u16string& text,
+                                            ResultCallback callback) {
+  EnsureLanguageDetectionModelReady(base::BindOnce(
+      &LocalQuickTranslateProvider::ContinueTranslate,
+      weak_ptr_factory_.GetWeakPtr(), text, std::move(callback)));
+}
+
+void LocalQuickTranslateProvider::EnsureLanguageDetectionModelReady(
+    base::OnceClosure done) {
+  if (language_detection::GetLanguageDetectionModel().IsAvailable()) {
+    std::move(done).Run();
+    return;
+  }
+  // The process-wide singleton above is never populated on its own in the
+  // browser process - only a renderer normally requests and loads it (for
+  // the legacy translate pipeline's own detection). Request it explicitly
+  // via the service that already holds it (fed by the
+  // --optimization-guide-model-override bundled model, see
+  // chrome_main_delegate.cc) and load it into that singleton ourselves.
+  auto* service =
+      LanguageDetectionModelServiceFactory::GetForProfile(profile_);
+  if (!service) {
+    std::move(done).Run();
+    return;
+  }
+  service->GetLanguageDetectionModelFile(base::BindOnce(
+      &LocalQuickTranslateProvider::OnLanguageDetectionModelFile,
+      weak_ptr_factory_.GetWeakPtr(), std::move(done)));
+}
+
+void LocalQuickTranslateProvider::OnLanguageDetectionModelFile(
+    base::OnceClosure done,
+    base::File file) {
+  if (!file.IsValid()) {
+    std::move(done).Run();
+    return;
+  }
+  language_detection::GetLanguageDetectionModel().UpdateWithFileAsync(
+      std::move(file), std::move(done));
+}
+
+void LocalQuickTranslateProvider::ContinueTranslate(std::u16string text,
+                                                    ResultCallback callback) {
+  std::string source_lang;
+  language_detection::LanguageDetectionModel& model =
+      language_detection::GetLanguageDetectionModel();
+  if (model.IsAvailable()) {
+    source_lang = model.PredictTopLanguageWithSamples(text).language;
+  }
+
+  std::string target_lang = GetTargetLanguage();
+
+  if (!source_lang.empty() && source_lang == target_lang) {
+    Result result;
+    result.status = Status::kSameLanguage;
+    result.source_language = source_lang;
+    result.target_language = target_lang;
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+
+  if (!IsReady()) {
+    Result result;
+    result.status = Status::kNotReady;
+    result.source_language = source_lang;
+    result.target_language = target_lang;
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+
+  on_device_translation::ServiceControllerManagerFactory::GetInstance()
+      ->Get(profile_)
+      ->CreateTranslator(
+          QuickTranslateOrigin(), source_lang, target_lang,
+          base::BindOnce(&LocalQuickTranslateProvider::OnTranslatorCreated,
+                         weak_ptr_factory_.GetWeakPtr(), source_lang,
+                         target_lang, text, std::move(callback)));
+}
+
+void LocalQuickTranslateProvider::OnTranslatorCreated(
+    std::string source_lang,
+    std::string target_lang,
+    std::u16string text,
+    ResultCallback callback,
+    base::expected<mojo::PendingRemote<OnDeviceTranslator>,
+                   CreateTranslatorError> result) {
+  if (!result.has_value()) {
+    Result out;
+    out.source_language = source_lang;
+    out.target_language = target_lang;
+    out.status = result.error() == CreateTranslatorError::kNotSupportedLanguage
+                    ? Status::kUnsupportedLanguage
+                    : Status::kError;
+    std::move(callback).Run(std::move(out));
+    return;
+  }
+
+  // The mojo::Remote must outlive the Translate() call - keep it alive by
+  // handing ownership to its own response callback, which destroys it once
+  // the translation completes (or drops it harmlessly if `this` is gone).
+  auto remote =
+      std::make_unique<mojo::Remote<OnDeviceTranslator>>(std::move(*result));
+  mojo::Remote<OnDeviceTranslator>* raw_remote = remote.get();
+  (*raw_remote)->Translate(
+      base::UTF16ToUTF8(text),
+      base::BindOnce(&LocalQuickTranslateProvider::OnTranslated,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(remote),
+                     source_lang, target_lang, std::move(callback)));
+}
+
+void LocalQuickTranslateProvider::OnTranslated(
+    std::unique_ptr<mojo::Remote<OnDeviceTranslator>> translator,
+    std::string source_lang,
+    std::string target_lang,
+    ResultCallback callback,
+    const std::optional<std::string>& output) {
+  Result result;
+  result.source_language = source_lang;
+  result.target_language = target_lang;
+  if (output.has_value()) {
+    result.status = Status::kOk;
+    result.translated_text = base::UTF8ToUTF16(*output);
+  } else {
+    result.status = Status::kError;
+  }
+  std::move(callback).Run(std::move(result));
+}
+
+}  // namespace quick_translate
diff --git a/chrome/browser/quick_translate/local_quick_translate_provider.h b/chrome/browser/quick_translate/local_quick_translate_provider.h
new file mode 100644
index 0000000000..4ff4d8186d
--- /dev/null
+++ b/chrome/browser/quick_translate/local_quick_translate_provider.h
@@ -0,0 +1,100 @@
+// Copyright 2026 The NBrowser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_QUICK_TRANSLATE_LOCAL_QUICK_TRANSLATE_PROVIDER_H_
+#define CHROME_BROWSER_QUICK_TRANSLATE_LOCAL_QUICK_TRANSLATE_PROVIDER_H_
+
+#include <optional>
+#include <string>
+
+#include "base/files/file.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/types/expected.h"
+#include "chrome/browser/quick_translate/quick_translate_provider.h"
+#include "components/on_device_translation/service_controller.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+class Profile;
+
+namespace on_device_translation {
+namespace mojom {
+class OnDeviceTranslator;
+}  // namespace mojom
+}  // namespace on_device_translation
+
+namespace quick_translate {
+
+// Translates text fully on-device via Chromium's TranslateKit engine
+// (components/on_device_translation), bypassing the legacy, network-based
+// components/translate pipeline entirely. Source-language detection also
+// runs locally (components/language_detection).
+class LocalQuickTranslateProvider : public QuickTranslateProvider {
+ public:
+  explicit LocalQuickTranslateProvider(Profile* profile);
+  ~LocalQuickTranslateProvider() override;
+
+  LocalQuickTranslateProvider(const LocalQuickTranslateProvider&) = delete;
+  LocalQuickTranslateProvider& operator=(const LocalQuickTranslateProvider&) =
+      delete;
+
+  // QuickTranslateProvider:
+  void Translate(const std::u16string& text,
+                ResultCallback callback) override;
+  bool IsReady() const override;
+
+  // The user's configured translation target language - the same value
+  // Translate() resolves internally. Exposed so
+  // FallbackQuickTranslateProvider can decide which language to request
+  // from the remote provider without duplicating this lookup.
+  //
+  // Delegates to translate::TranslateManager::GetTargetLanguage() rather
+  // than reading TranslatePrefs::GetRecentTargetLanguage() directly:
+  // "recent target" is only ever populated by an actual on-page translation
+  // via the legacy components/translate UI, which most users - especially
+  // on a profile that has never triggered it - will never have done, so
+  // reading it directly returns an empty string. TranslateManager's version
+  // falls back through the language model ranking, the browser's UI
+  // language, and the Accept-Language list before finally defaulting to
+  // "en", so it always returns a real, non-empty language code.
+  std::string GetTargetLanguage() const;
+
+ private:
+  using OnDeviceTranslator = on_device_translation::mojom::OnDeviceTranslator;
+  using CreateTranslatorError =
+      on_device_translation::OnDeviceTranslationController::
+          CreateTranslatorError;
+
+  // The process-wide language_detection::GetLanguageDetectionModel()
+  // singleton is never populated in the browser process on its own - only
+  // renderers request and load its file today (for the legacy translate
+  // pipeline). Requests it once via LanguageDetectionModelService and loads
+  // it into that singleton before continuing; a no-op if already loaded.
+  void EnsureLanguageDetectionModelReady(base::OnceClosure done);
+  void OnLanguageDetectionModelFile(base::OnceClosure done, base::File file);
+
+  void ContinueTranslate(std::u16string text, ResultCallback callback);
+
+  void OnTranslatorCreated(
+      std::string source_lang,
+      std::string target_lang,
+      std::u16string text,
+      ResultCallback callback,
+      base::expected<mojo::PendingRemote<OnDeviceTranslator>,
+                     CreateTranslatorError> result);
+  void OnTranslated(std::unique_ptr<mojo::Remote<OnDeviceTranslator>> unused,
+                    std::string source_lang,
+                    std::string target_lang,
+                    ResultCallback callback,
+                    const std::optional<std::string>& output);
+
+  raw_ptr<Profile> profile_;
+  base::WeakPtrFactory<LocalQuickTranslateProvider> weak_ptr_factory_{this};
+};
+
+}  // namespace quick_translate
+
+#endif  // CHROME_BROWSER_QUICK_TRANSLATE_LOCAL_QUICK_TRANSLATE_PROVIDER_H_
diff --git a/chrome/browser/quick_translate/quick_translate_prefs.cc b/chrome/browser/quick_translate/quick_translate_prefs.cc
new file mode 100644
index 0000000000..2e9b596213
--- /dev/null
+++ b/chrome/browser/quick_translate/quick_translate_prefs.cc
@@ -0,0 +1,19 @@
+// Copyright 2026 The NBrowser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/quick_translate/quick_translate_prefs.h"
+
+#include "components/pref_registry/pref_registry_syncable.h"
+
+namespace quick_translate {
+namespace prefs {
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterBooleanPref(kQuickTranslateEnabled, true);
+  registry->RegisterBooleanPref(kQuickTranslateUseOfflineModel, true);
+  registry->RegisterBooleanPref(kQuickTranslateUseOnlineModel, false);
