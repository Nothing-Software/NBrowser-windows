@@ -0,0 +1,50 @@
+// Copyright 2026 The NBrowser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_QUICK_TRANSLATE_QUICK_TRANSLATE_REQUEST_H_
+#define CHROME_BROWSER_QUICK_TRANSLATE_QUICK_TRANSLATE_REQUEST_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/quick_translate/quick_translate_provider.h"
+
+class Profile;
+
+namespace quick_translate {
+
+// A single, per-context-menu-invocation translation attempt. Owned by
+// whoever displays the result (the Views inline preview), not by
+// QuickTranslateService - unlike the profile-scoped provider, this object's
+// lifetime matches one open context menu. Its own WeakPtrFactory ensures
+// that closing the menu mid-translation simply drops the eventual result
+// instead of calling into a destroyed UI object.
+class QuickTranslateRequest {
+ public:
+  using ResultCallback =
+      base::OnceCallback<void(QuickTranslateProvider::Result)>;
+
+  QuickTranslateRequest();
+  ~QuickTranslateRequest();
+
+  QuickTranslateRequest(const QuickTranslateRequest&) = delete;
+  QuickTranslateRequest& operator=(const QuickTranslateRequest&) = delete;
+
+  // Starts translating `selection_text` using `profile`'s configured
+  // QuickTranslateProvider. `callback` is invoked exactly once, unless
+  // `this` is destroyed first, in which case it is never invoked.
+  void Start(Profile* profile,
+            const std::u16string& selection_text,
+            ResultCallback callback);
+
+ private:
+  void OnResult(ResultCallback callback, QuickTranslateProvider::Result result);
+
+  base::WeakPtrFactory<QuickTranslateRequest> weak_ptr_factory_{this};
+};
+
+}  // namespace quick_translate
+
+#endif  // CHROME_BROWSER_QUICK_TRANSLATE_QUICK_TRANSLATE_REQUEST_H_
