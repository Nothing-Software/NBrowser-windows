diff --git a/chrome/browser/quick_translate/remote_quick_translate_provider.cc b/chrome/browser/quick_translate/remote_quick_translate_provider.cc
new file mode 100644
index 0000000000..041af5be26
--- /dev/null
+++ b/chrome/browser/quick_translate/remote_quick_translate_provider.cc
@@ -0,0 +1,168 @@
+// Copyright 2026 The NBrowser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/quick_translate/remote_quick_translate_provider.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "net/base/url_util.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "url/gurl.h"
+
+namespace quick_translate {
+
+namespace {
+
+using Status = QuickTranslateProvider::Status;
+
+// Google's unofficial, key-less translation endpoint - the same one used by
+// countless browser extensions and command-line tools. "client=gtx" selects
+// this public frontend; "dt=t" asks for translated-text segments only.
+constexpr char kTranslateEndpoint[] =
+    "https://translate.googleapis.com/translate_a/single";
+
+constexpr size_t kMaxResponseBytes = 64 * 1024;
+constexpr base::TimeDelta kRequestTimeout = base::Seconds(5);
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotationTag =
+    net::DefineNetworkTrafficAnnotation("quick_translate_remote", R"(
+        semantics {
+          sender: "Quick Translate"
+          description:
+            "Sends the text the user selected on a page, and the user's "
+            "configured target language, to Google's public translation "
+            "endpoint, for the 'Quick Translate' context-menu preview."
+          trigger:
+            "The user right-clicks selected page text with 'Use an "
+            "online model for Quick Translate' enabled in "
+            "chrome://settings/languages."
+          data:
+            "The selected text and the target language code. No cookies "
+            "or other identifying data are sent."
+          destination: GOOGLE_OWNED_SERVICE
+          internal {
+            contacts {
+              email: "contact@aerlab.net"
+            }
+          }
+          user_data {
+            type: NONE
+          }
+          last_reviewed: "2026-09-02"
+        }
+        policy {
+          cookies_allowed: NO
+          cookies_store: ""
+          setting:
+            "This feature is disabled by default and is enabled by the "
+            "user via the 'Use an online model for Quick Translate' "
+            "toggle in chrome://settings/languages."
+          policy_exception_justification:
+            "Not implemented yet. NBrowser has no enterprise policy "
+            "support."
+        })");
+
+GURL BuildRequestUrl(const std::u16string& text,
+                     const std::string& target_lang) {
+  GURL url(kTranslateEndpoint);
+  url = net::AppendOrReplaceQueryParameter(url, "client", "gtx");
+  url = net::AppendOrReplaceQueryParameter(url, "sl", "auto");
+  url = net::AppendOrReplaceQueryParameter(url, "dt", "t");
+  url = net::AppendOrReplaceQueryParameter(url, "tl", target_lang);
+  url = net::AppendOrReplaceQueryParameter(url, "q", base::UTF16ToUTF8(text));
+  return url;
+}
+
+// Extracts the translated text from the endpoint's response, which is an
+// unofficial, undocumented top-level JSON array (not an object) shaped
+// roughly like:
+//   [[[translated_segment, original_segment, ...], ...], null, source_lang]
+// Returns std::nullopt if `body` doesn't match this shape.
+std::optional<std::u16string> ExtractTranslatedText(
+    const base::ListValue& segments) {
+  std::u16string translated_text;
+  for (const base::Value& segment_value : segments) {
+    if (!segment_value.is_list()) {
+      return std::nullopt;
+    }
+    const base::ListValue& segment = segment_value.GetList();
+    if (segment.empty() || !segment[0].is_string()) {
+      return std::nullopt;
+    }
+    translated_text += base::UTF8ToUTF16(segment[0].GetString());
+  }
+  return translated_text;
+}
+
+}  // namespace
+
+RemoteQuickTranslateProvider::RemoteQuickTranslateProvider(Profile* profile)
+    : profile_(profile) {}
+
+RemoteQuickTranslateProvider::~RemoteQuickTranslateProvider() = default;
+
+void RemoteQuickTranslateProvider::Translate(const std::u16string& text,
+                                             const std::string& target_lang,
+                                             ResultCallback callback) {
+  auto resource_request = std::make_unique<network::ResourceRequest>();
+  resource_request->url = BuildRequestUrl(text, target_lang);
+  resource_request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+
+  auto loader = network::SimpleURLLoader::Create(std::move(resource_request),
+                                                 kTrafficAnnotationTag);
+  loader->SetTimeoutDuration(kRequestTimeout);
+  network::SimpleURLLoader* raw_loader = loader.get();
+  raw_loader->DownloadToString(
+      profile_->GetURLLoaderFactory().get(),
+      base::BindOnce(&RemoteQuickTranslateProvider::OnResponse,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(loader),
+                     target_lang, std::move(callback)),
+      kMaxResponseBytes);
+}
+
+void RemoteQuickTranslateProvider::OnResponse(
+    std::unique_ptr<network::SimpleURLLoader> loader,
+    std::string target_lang,
+    ResultCallback callback,
+    std::optional<std::string> response_body) {
+  Result result;
+  result.target_language = target_lang;
+
+  std::optional<base::ListValue> parsed;
+  if (response_body) {
+    parsed = base::JSONReader::ReadList(*response_body, base::JSON_PARSE_RFC);
+  }
+
+  std::optional<std::u16string> translated_text;
+  if (parsed && parsed->size() >= 3 && (*parsed)[0].is_list() &&
+      (*parsed)[2].is_string()) {
+    translated_text = ExtractTranslatedText((*parsed)[0].GetList());
+  }
+
+  if (!translated_text) {
+    result.status = Status::kError;
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+
+  result.source_language = (*parsed)[2].GetString();
+  if (result.source_language == target_lang) {
+    result.status = Status::kSameLanguage;
+  } else {
+    result.status = Status::kOk;
+    result.translated_text = std::move(*translated_text);
+  }
+  std::move(callback).Run(std::move(result));
+}
+
+}  // namespace quick_translate
