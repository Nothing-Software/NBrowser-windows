+// Copyright 2026 The NBrowser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/quick_translate/quick_translate_request.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/quick_translate/quick_translate_service.h"
+#include "chrome/browser/quick_translate/quick_translate_service_factory.h"
+
+namespace quick_translate {
+
+QuickTranslateRequest::QuickTranslateRequest() = default;
+QuickTranslateRequest::~QuickTranslateRequest() = default;
+
+void QuickTranslateRequest::Start(Profile* profile,
+                                  const std::u16string& selection_text,
+                                  ResultCallback callback) {
+  QuickTranslateProvider* provider =
+      QuickTranslateServiceFactory::GetForProfile(profile)->GetProvider();
+  provider->Translate(
+      selection_text,
+      base::BindOnce(&QuickTranslateRequest::OnResult,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void QuickTranslateRequest::OnResult(ResultCallback callback,
+                                     QuickTranslateProvider::Result result) {
+  std::move(callback).Run(std::move(result));
+}
+
+}  // namespace quick_translate
