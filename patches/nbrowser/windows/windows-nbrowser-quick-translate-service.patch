index 0000000000..2607e1cf56
--- /dev/null
+++ b/chrome/browser/quick_translate/quick_translate_service.h
@@ -0,0 +1,38 @@
+// Copyright 2026 The NBrowser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_QUICK_TRANSLATE_QUICK_TRANSLATE_SERVICE_H_
+#define CHROME_BROWSER_QUICK_TRANSLATE_QUICK_TRANSLATE_SERVICE_H_
+
+#include <memory>
+
+#include "components/keyed_service/core/keyed_service.h"
+
+class Profile;
+
+namespace quick_translate {
+
+class QuickTranslateProvider;
+
+// Per-profile owner of the QuickTranslateProvider backend. Kept as its own
+// KeyedService (rather than having QuickTranslateRequest construct a
+// provider directly) so a future remote provider can be selected here based
+// on a user setting, with no change needed anywhere else.
+class QuickTranslateService : public KeyedService {
+ public:
+  explicit QuickTranslateService(Profile* profile);
+  ~QuickTranslateService() override;
+
+  QuickTranslateService(const QuickTranslateService&) = delete;
+  QuickTranslateService& operator=(const QuickTranslateService&) = delete;
+
+  QuickTranslateProvider* GetProvider();
+
+ private:
+  std::unique_ptr<QuickTranslateProvider> provider_;
+};
