+#include "chrome/browser/quick_translate/quick_translate_service_factory.h"
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_selections.h"
+#include "chrome/browser/quick_translate/quick_translate_service.h"
+
+namespace quick_translate {
+
+// static
+QuickTranslateServiceFactory* QuickTranslateServiceFactory::GetInstance() {
+  static base::NoDestructor<QuickTranslateServiceFactory> instance;
+  return instance.get();
+}
+
+// static
+QuickTranslateService* QuickTranslateServiceFactory::GetForProfile(
+    Profile* profile) {
+  return static_cast<QuickTranslateService*>(
+      GetInstance()->GetServiceForBrowserContext(profile, true));
+}
+
+QuickTranslateServiceFactory::QuickTranslateServiceFactory()
+    : ProfileKeyedServiceFactory(
+          "QuickTranslateService",
+          ProfileSelections::Builder()
+              .WithRegular(ProfileSelection::kOwnInstance)
+              .WithGuest(ProfileSelection::kOwnInstance)
+              .Build()) {}
+
+QuickTranslateServiceFactory::~QuickTranslateServiceFactory() = default;
+
+std::unique_ptr<KeyedService>
+QuickTranslateServiceFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  return std::make_unique<QuickTranslateService>(
+      Profile::FromBrowserContext(context));
+}
+
+}  // namespace quick_translate
