+++ b/chrome/browser/quick_translate/remote_quick_translate_provider.h
@@ -0,0 +1,67 @@
+// Copyright 2026 The NBrowser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_QUICK_TRANSLATE_REMOTE_QUICK_TRANSLATE_PROVIDER_H_
+#define CHROME_BROWSER_QUICK_TRANSLATE_REMOTE_QUICK_TRANSLATE_PROVIDER_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/quick_translate/quick_translate_provider.h"
+
+class Profile;
+
+namespace network {
+class SimpleURLLoader;
+}  // namespace network
+
+namespace quick_translate {
+
+// Translates text via Google's public, key-less "gtx" translation endpoint.
+// Unlike LocalQuickTranslateProvider, it supports arbitrary language pairs
+// (the source language is auto-detected server-side) but requires network
+// connectivity.
+//
+// This is a leaf network helper, not itself a QuickTranslateProvider: it
+// has no notion of the user's target-language preference, and its result
+// never carries anything but kOk or kError. FallbackQuickTranslateProvider
+// is the QuickTranslateProvider that actually uses this, layering in the
+// target-language lookup and the local-engine fallback.
+class RemoteQuickTranslateProvider {
+ public:
+  using Result = QuickTranslateProvider::Result;
+  using ResultCallback = QuickTranslateProvider::ResultCallback;
+
+  explicit RemoteQuickTranslateProvider(Profile* profile);
+  ~RemoteQuickTranslateProvider();
+
+  RemoteQuickTranslateProvider(const RemoteQuickTranslateProvider&) = delete;
+  RemoteQuickTranslateProvider& operator=(
+      const RemoteQuickTranslateProvider&) = delete;
+
+  // Translates `text` to `target_lang`. Invokes `callback` exactly once,
+  // with Status::kOk or Status::kSameLanguage on success, or
+  // Status::kError for any network failure, timeout, or malformed
+  // response - the caller decides what to do about that (e.g. fall back to
+  // a local engine).
+  void Translate(const std::u16string& text,
+                 const std::string& target_lang,
+                 ResultCallback callback);
+
+ private:
+  void OnResponse(std::unique_ptr<network::SimpleURLLoader> loader,
+                   std::string target_lang,
+                   ResultCallback callback,
+                   std::optional<std::string> response_body);
+
+  raw_ptr<Profile> profile_;
+  base::WeakPtrFactory<RemoteQuickTranslateProvider> weak_ptr_factory_{this};
+};
+
+}  // namespace quick_translate
+
+#endif  // CHROME_BROWSER_QUICK_TRANSLATE_REMOTE_QUICK_TRANSLATE_PROVIDER_H_
