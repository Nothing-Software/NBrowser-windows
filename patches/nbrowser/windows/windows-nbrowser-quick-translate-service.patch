diff --git a/chrome/browser/quick_translate/quick_translate_provider.h b/chrome/browser/quick_translate/quick_translate_provider.h
new file mode 100644
index 0000000000..35a5ba067c
--- /dev/null
+++ b/chrome/browser/quick_translate/quick_translate_provider.h
@@ -0,0 +1,68 @@
+// Copyright 2026 The NBrowser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_QUICK_TRANSLATE_QUICK_TRANSLATE_PROVIDER_H_
+#define CHROME_BROWSER_QUICK_TRANSLATE_QUICK_TRANSLATE_PROVIDER_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+
+namespace quick_translate {
+
+// Backend abstraction for the "Quick Translate" context-menu feature.
+// QuickTranslateService installs a single FallbackQuickTranslateProvider,
+// which itself composes LocalQuickTranslateProvider (on-device TranslateKit)
+// and, when the user opts in, RemoteQuickTranslateProvider - see
+// fallback_quick_translate_provider.h for the selection policy between the
+// two. The context-menu/UI code only ever sees this interface.
+class QuickTranslateProvider {
+ public:
+  enum class Status {
+    // `translated_text` holds a usable translation.
+    kOk,
+    // The engine isn't available yet (e.g. the local engine's files were not
+    // bundled with this install).
+    kNotReady,
+    // The detected/requested language pair isn't supported by the provider.
+    kUnsupportedLanguage,
+    // The detected source language already matches the target language.
+    kSameLanguage,
+    // An online provider was required (the requested language pair isn't
+    // covered locally, or the user's remote attempt just failed) but no
+    // usable network connection was available.
+    kNoConnection,
+    // Translation failed for a reason not covered above.
+    kError,
+  };
+
+  struct Result {
+    Status status = Status::kError;
+    // Best-effort detected source language (BCP-47 / ISO 639-1), empty if
+    // detection was unavailable or inconclusive.
+    std::string source_language;
+    // The user's configured target language.
+    std::string target_language;
+    // Valid iff `status == Status::kOk`.
+    std::u16string translated_text;
+  };
+
+  using ResultCallback = base::OnceCallback<void(Result)>;
+
+  virtual ~QuickTranslateProvider() = default;
+
+  // Detects the source language of `text`, translates it to the user's
+  // configured target language, and invokes `callback` exactly once with the
+  // outcome.
+  virtual void Translate(const std::u16string& text,
+                         ResultCallback callback) = 0;
+
+  // Cheap, synchronous readiness check used to decide whether to show a
+  // "preparing..." placeholder before attempting a translation.
+  virtual bool IsReady() const = 0;
+};
+
+}  // namespace quick_translate
+
+#endif  // CHROME_BROWSER_QUICK_TRANSLATE_QUICK_TRANSLATE_PROVIDER_H_
