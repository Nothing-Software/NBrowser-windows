diff --git a/chrome/app/chrome_main_delegate.cc b/chrome/app/chrome_main_delegate.cc
index 45f00944bf..ddd90fd5fa 100644
--- a/chrome/app/chrome_main_delegate.cc
+++ b/chrome/app/chrome_main_delegate.cc
@@ -76,6 +76,8 @@
 #include "components/memory_system/initializer.h"
 #include "components/memory_system/parameters.h"
 #include "components/metrics/persistent_histograms.h"
+#include "components/on_device_translation/features.h"
+#include "components/optimization_guide/core/optimization_guide_switches.h"
 #include "components/sampling_profiler/thread_profiler.h"
 #include "components/startup_metric_utils/common/startup_metric_utils.h"
 #include "components/variations/service/variations_network_clock.h"
@@ -1100,6 +1102,58 @@ std::optional<int> ChromeMainDelegate::BasicStartupComplete() {
   // The DevTools remote debugging pipe file descriptors need to be checked
   // before any other files are opened, see https://crbug.com/40259890.
   const bool is_browser = !command_line.HasSwitch(switches::kProcessType);
+
+  // NBrowser: force smooth scrolling on regardless of the OS-level animation
+  // setting and independent of chrome://flags (Reset All only clears the
+  // flags storage, not this switch).
+  if (is_browser) {
+    base::CommandLine::ForCurrentProcess()->AppendSwitch(
+        switches::kEnableSmoothScrolling);
+    // NBrowser: never close the window when its last tab closes - matches
+    // the "close-window-with-last-tab" ungoogled-chromium flag's "Never"
+    // choice, forced independent of chrome://flags for the same reason.
+    base::CommandLine::ForCurrentProcess()->AppendSwitchASCII(
+        "close-window-with-last-tab", "never");
+
+    // NBrowser: point the on-device translation engine (TranslateKit) at the
+    // copy bundled with this install instead of relying on component
+    // updater, which ungoogled-chromium's block-requests.patch disables
+    // unconditionally (see components/update_client/update_checker.cc) -
+    // Quick Translate would otherwise never receive the engine/language
+    // packs it needs. "translate-kit-packages" mirrors the literal switch
+    // name in chrome/browser/on_device_translation/installer_impl.cc (it's
+    // not exported as a symbol from that file).
+    base::FilePath install_dir;
+    if (base::PathService::Get(base::DIR_ASSETS, &install_dir)) {
+      base::FilePath translate_kit_dir =
+          install_dir.AppendASCII("TranslateKitFiles");
+      base::CommandLine::ForCurrentProcess()->AppendSwitchPath(
+          on_device_translation::kTranslateKitBinaryPath,
+          translate_kit_dir.Append(
+              FILE_PATH_LITERAL("libtranslatekit.dll")));
+      base::CommandLine::ForCurrentProcess()->AppendSwitchNative(
+          "translate-kit-packages",
+          FILE_PATH_LITERAL("en,ru,") +
+              translate_kit_dir.Append(FILE_PATH_LITERAL("LanguagePacks"))
+                  .Append(FILE_PATH_LITERAL("en_ru"))
+                  .value());
+
+      // NBrowser: point local language detection (used to guess Quick
+      // Translate's source language) at the model file bundled with this
+      // install, the same way as TranslateKit just above - its real delivery
+      // path (Optimization Guide's model fetcher) needs a Google API key
+      // that ungoogled-chromium blanks out, so it never downloads on its
+      // own. --optimization-guide-model-override is a real, existing
+      // upstream flag for exactly this ("point this optimization target at
+      // a local file"), not something added for this feature.
+      base::CommandLine::ForCurrentProcess()->AppendSwitchNative(
+          optimization_guide::switches::kModelOverride,
+          FILE_PATH_LITERAL("OPTIMIZATION_TARGET_LANGUAGE_DETECTION|") +
+              install_dir.AppendASCII("LanguageDetectionModel")
+                  .Append(FILE_PATH_LITERAL("model.tflite"))
+                  .value());
+    }
+  }
 #if BUILDFLAG(IS_WIN)
   const bool pipes_are_specified_explicitly =
       command_line.HasSwitch(::switches::kRemoteDebuggingIoPipes);
