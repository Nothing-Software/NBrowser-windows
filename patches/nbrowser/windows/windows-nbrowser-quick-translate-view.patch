diff --git a/chrome/browser/ui/views/renderer_context_menu/quick_translate_menu_view.cc b/chrome/browser/ui/views/renderer_context_menu/quick_translate_menu_view.cc
new file mode 100644
index 0000000000..c48098e7d5
--- /dev/null
+++ b/chrome/browser/ui/views/renderer_context_menu/quick_translate_menu_view.cc
@@ -0,0 +1,161 @@
+// Copyright 2026 The NBrowser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/renderer_context_menu/quick_translate_menu_view.h"
+
+#include <memory>
+#include <utility>
+
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/ui/webui/nbrowser_ui_strings/grit/nbrowser_ui_strings.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_id.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/text_constants.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/controls/menu/menu_config.h"
+#include "ui/views/controls/throbber.h"
+#include "ui/views/layout/box_layout.h"
+
+namespace quick_translate {
+
+namespace {
+
+constexpr int kHorizontalPadding = 14;
+constexpr int kVerticalPadding = 8;
+constexpr int kBetweenLabelSpacing = 3;
+
+// A deliberately narrow width used only to compute this view's preferred
+// HEIGHT (see CalculatePreferredSize() below) - the row still visually
+// stretches to whatever the menu's real width ends up being via
+// set_children_use_full_width(true) in render_view_context_menu_views.cc.
+constexpr int kFixedWidthForHeightCalc = 240;
+
+std::unique_ptr<views::Label> CreateRowLabel(ui::ColorId color,
+                                             int font_size_delta) {
+  auto label = std::make_unique<views::Label>();
+  label->SetAutoColorReadabilityEnabled(false);
+  label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  label->SetMultiLine(true);
+  label->SetEnabledColor(color);
+  label->SetFontList(views::MenuConfig::instance().font_list.DeriveWithSizeDelta(
+      font_size_delta));
+  return label;
+}
+
+}  // namespace
+
+QuickTranslateMenuView::QuickTranslateMenuView() {
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical,
+      gfx::Insets::VH(kVerticalPadding, kHorizontalPadding),
+      kBetweenLabelSpacing));
+
+  // views::BoxLayout applies one cross-axis alignment to every direct
+  // child, and the labels below need CrossAxisAlignment::kStretch (the
+  // default) so their real width is known and multi-line wrapping works.
+  // Wrapping the throbber in its own row keeps it at its natural 16x16
+  // size, left-aligned, instead of being stretched into a flattened oval
+  // across the whole menu width.
+  auto throbber_row = std::make_unique<views::View>();
+  throbber_row->SetLayoutManager(
+      std::make_unique<views::BoxLayout>(views::BoxLayout::Orientation::kHorizontal));
+  throbber_ = throbber_row->AddChildView(std::make_unique<views::Throbber>());
+  throbber_->Start();
+  throbber_row_ = AddChildView(std::move(throbber_row));
+
+  // Smaller, muted "SourceLang -> TargetLang" line above the prominent
+  // translated text - the same visual hierarchy as a subtitle under a title.
+  language_pair_label_ = AddChildView(
+      CreateRowLabel(ui::kColorMenuItemForegroundSecondary, -1));
+  language_pair_label_->SetVisible(false);
+
+  text_label_ = AddChildView(
+      CreateRowLabel(ui::kColorMenuItemForeground, /*font_size_delta=*/0));
+  text_label_->SetVisible(false);
+}
+
+QuickTranslateMenuView::~QuickTranslateMenuView() = default;
+
+void QuickTranslateMenuView::SetResult(
+    const QuickTranslateProvider::Result& result) {
+  using Status = QuickTranslateProvider::Status;
+  const std::string app_locale = g_browser_process->GetApplicationLocale();
+
+  throbber_->Stop();
+  throbber_row_->SetVisible(false);
+  text_label_->SetVisible(true);
+  language_pair_label_->SetVisible(result.status == Status::kOk);
+
+  switch (result.status) {
+    case Status::kOk: {
+      std::u16string target_name = l10n_util::GetDisplayNameForLocale(
+          result.target_language, app_locale, /*is_for_ui=*/true);
+      if (!result.source_language.empty()) {
+        std::u16string source_name = l10n_util::GetDisplayNameForLocale(
+            result.source_language, app_locale, /*is_for_ui=*/true);
+        language_pair_label_->SetText(source_name + u" → " +
+                                      target_name);
+      } else {
+        language_pair_label_->SetText(target_name);
+      }
+      text_label_->SetText(result.translated_text);
+      break;
+    }
+    case Status::kSameLanguage:
+      text_label_->SetText(
+          l10n_util::GetStringUTF16(IDS_QUICK_TRANSLATE_ALREADY_TRANSLATED));
+      break;
+    case Status::kUnsupportedLanguage:
+      text_label_->SetText(l10n_util::GetStringUTF16(
+          IDS_QUICK_TRANSLATE_UNSUPPORTED_LANGUAGE));
+      break;
+    case Status::kNotReady:
+      text_label_->SetText(
+          l10n_util::GetStringUTF16(IDS_QUICK_TRANSLATE_PREPARING));
+      break;
+    case Status::kNoConnection:
+      text_label_->SetText(
+          l10n_util::GetStringUTF16(IDS_QUICK_TRANSLATE_NO_CONNECTION));
+      break;
+    case Status::kError:
+      text_label_->SetText(
+          l10n_util::GetStringUTF16(IDS_QUICK_TRANSLATE_UNAVAILABLE));
+      break;
+  }
+
+  // Notifies the MenuItemView/SubmenuView ancestry that this view's
+  // preferred size may have changed, which is what actually lets an
+  // ALREADY-OPEN menu resize/reposition itself (see
+  // SubmenuView::ChildPreferredSizeChanged() and
+  // set_resize_open_menu(true) in render_view_context_menu_views.cc) -
+  // InvalidateLayout() alone only re-lays-out this view's own children.
+  PreferredSizeChanged();
+}
+
+base::WeakPtr<QuickTranslateMenuView> QuickTranslateMenuView::GetWeakPtr() {
+  return weak_ptr_factory_.GetWeakPtr();
+}
+
+gfx::Size QuickTranslateMenuView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  // Multi-line labels can only report a correct wrapped HEIGHT once a width
+  // is fixed. Use the real width we're being laid out at whenever the
+  // caller actually provides one (true once the menu is open and
+  // SubmenuView::ChildPreferredSizeChanged() re-queries this after
+  // set_resize_open_menu(true) - see render_view_context_menu_views.cc) so
+  // the height stays genuinely dynamic and matches the real content. Only
+  // fall back to a fixed estimate for the very first query, before the menu
+  // has an established width to report (unbounded available_size) - a menu
+  // a bit taller than strictly necessary there beats one that clips.
+  int width = available_size.width().value_or(kFixedWidthForHeightCalc);
+  int height = GetLayoutManager()->GetPreferredHeightForWidth(this, width);
+  return gfx::Size(width, height);
+}
+
+BEGIN_METADATA(QuickTranslateMenuView)
+END_METADATA
+
+}  // namespace quick_translate
