 #include "chrome/common/chrome_switches.h"
 #include "components/lens/buildflags.h"
@@ -408,6 +411,42 @@ void RenderViewContextMenuViews::Show() {
   if (screen_position_client) {
     screen_position_client->ConvertPointToScreen(target_window, &screen_point);
   }
+  // NBrowser: attach the local Quick Translate inline preview, if the model
+  // added the row (see RenderViewContextMenu::AppendQuickTranslateItem()).
+  // Must happen before the blocking RunMenuAt() call below - control doesn't
+  // return here until the menu closes, so there is no other place in this
+  // function to do it. RefreshQuickTranslateView() also gets re-invoked
+  // whenever the menu is rebuilt (see its own comment and
+  // ToolkitDelegateViews::RebuildMenu()), so the row survives things like
+  // late-arriving async spellcheck suggestions.
+  RefreshQuickTranslateView();
+  static_cast<ToolkitDelegateViews*>(toolkit_delegate())
+      ->set_rebuild_callback(base::BindRepeating(
+          &RenderViewContextMenuViews::RefreshQuickTranslateView,
+          base::Unretained(this)));
+  if (views::SubmenuView* root_submenu =
+          static_cast<ToolkitDelegateViews*>(toolkit_delegate())
+              ->menu_view()
+              ->GetSubmenu()) {
+    // NBrowser: without this, an already-open menu never resizes/repositions
+    // itself when a child's preferred size changes later - which is exactly
+    // what happens here (the Quick Translate row starts as one short
+    // placeholder line, then grows once the translation arrives). See
+    // SubmenuView::ChildPreferredSizeChanged() (ui/views/controls/menu/
+    // submenu_view.cc) - it's a no-op unless this flag is set.
+    root_submenu->set_resize_open_menu(true);
+  }
+  if (static_cast<ToolkitDelegateViews*>(toolkit_delegate())
+          ->menu_view()
+          ->GetMenuItemByID(kQuickTranslateMenuId)) {
+    quick_translate_request_ =
+        std::make_unique<quick_translate::QuickTranslateRequest>();
+    quick_translate_request_->Start(
+        GetProfile(), params().selection_text,
+        base::BindOnce(&RenderViewContextMenuViews::OnQuickTranslateResult,
+                       base::Unretained(this)));
+  }
+
   // Enable recursive tasks on the message loop so we can get updates while
   // the context menu is being displayed.
   base::CurrentThread::ScopedAllowApplicationTasksInNativeNestedLoop allow;
@@ -429,6 +468,36 @@ void RenderViewContextMenuViews::Show() {
   }
 }
 
+void RenderViewContextMenuViews::RefreshQuickTranslateView() {
+  views::MenuItemView* quick_translate_item =
+      static_cast<ToolkitDelegateViews*>(toolkit_delegate())
+          ->menu_view()
+          ->GetMenuItemByID(kQuickTranslateMenuId);
+  if (!quick_translate_item) {
+    return;
+  }
+
+  if (!quick_translate_menu_view_) {
+    // Either the first attach, or RebuildMenu() just destroyed the previous
+    // child view along with the rest of the item's old subtree - (re)create
+    // it either way.
+    auto view = std::make_unique<quick_translate::QuickTranslateMenuView>();
+    quick_translate_menu_view_ = view->GetWeakPtr();
+    quick_translate_item->AddChildView(std::move(view));
+    quick_translate_item->set_children_use_full_width(true);
+  }
+
+  if (quick_translate_result_) {
+    quick_translate_menu_view_->SetResult(*quick_translate_result_);
+  }
+}
+
+void RenderViewContextMenuViews::OnQuickTranslateResult(
+    quick_translate::QuickTranslateProvider::Result result) {
+  quick_translate_result_ = std::move(result);
+  RefreshQuickTranslateView();
+}
+
 views::Widget* RenderViewContextMenuViews::GetTopLevelWidget() {
   return views::Widget::GetTopLevelWidgetForNativeView(GetActiveNativeView());
 }
