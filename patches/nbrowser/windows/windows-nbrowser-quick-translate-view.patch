+// Copyright 2026 The NBrowser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_RENDERER_CONTEXT_MENU_QUICK_TRANSLATE_MENU_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_RENDERER_CONTEXT_MENU_QUICK_TRANSLATE_MENU_VIEW_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/quick_translate/quick_translate_provider.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/view.h"
+
+namespace views {
+class Label;
+class Throbber;
+}  // namespace views
+
+namespace quick_translate {
+
+// Inline "SourceLang -> TargetLang" + translation preview painted directly
+// inside the Quick Translate context-menu row - not a separate popup/bubble.
+// Uses the same child-view-inside-a-MenuItemView technique as AppMenu's
+// ZoomView (chrome/browser/ui/views/toolbar/app_menu.cc): a plain
+// views::View added via MenuItemView::AddChildView() +
+// set_children_use_full_width(true).
+class QuickTranslateMenuView : public views::View {
+  METADATA_HEADER(QuickTranslateMenuView, views::View)
+
+ public:
+  QuickTranslateMenuView();
+  ~QuickTranslateMenuView() override;
+
+  QuickTranslateMenuView(const QuickTranslateMenuView&) = delete;
+  QuickTranslateMenuView& operator=(const QuickTranslateMenuView&) = delete;
+
+  // Updates the row in place to reflect `result` - safe to call while the
+  // menu is still open (Label::SetText() triggers a repaint of an open
+  // menu, the same way ZoomView's live percentage label does).
+  void SetResult(const QuickTranslateProvider::Result& result);
+
+  base::WeakPtr<QuickTranslateMenuView> GetWeakPtr();
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+
+ private:
+  // Wraps `throbber_` in its own row so the outer BoxLayout's cross-axis
+  // stretch (needed for the multi-line labels below to wrap against the
+  // menu's real width) doesn't also stretch the throbber itself into a
+  // flattened oval - see the .cc constructor for details.
+  raw_ptr<views::View> throbber_row_ = nullptr;
+  raw_ptr<views::Throbber> throbber_ = nullptr;
+  raw_ptr<views::Label> language_pair_label_ = nullptr;
+  raw_ptr<views::Label> text_label_ = nullptr;
+  base::WeakPtrFactory<QuickTranslateMenuView> weak_ptr_factory_{this};
+};
+
+}  // namespace quick_translate
+
+#endif  // CHROME_BROWSER_UI_VIEWS_RENDERER_CONTEXT_MENU_QUICK_TRANSLATE_MENU_VIEW_H_
