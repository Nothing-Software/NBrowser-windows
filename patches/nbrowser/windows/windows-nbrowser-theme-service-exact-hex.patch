+void ThemeService::SetExactHexColors(SkColor primary,
+                                     SkColor secondary,
+                                     SkColor accent) {
+  {
+    base::AutoReset<bool> resetter(&should_suppress_theme_updates_, true);
+    ClearThemeData(/*reset_all_settings=*/false);
+    profile_->GetPrefs()->SetInteger(prefs::kUserColor, primary);
+    profile_->GetPrefs()->SetInteger(prefs::kUserColorSecondary, secondary);
+    profile_->GetPrefs()->SetInteger(prefs::kUserColorAccent, accent);
+    profile_->GetPrefs()->SetBoolean(prefs::kIsExactHexTheme, true);
+    profile_->GetPrefs()->SetString(prefs::kCurrentThemeID, kUserColorThemeID);
+  }
+  NotifyThemeChanged();
+}
+
+bool ThemeService::GetIsExactHex() const {
+  return profile_->GetPrefs()->GetBoolean(prefs::kIsExactHexTheme);
+}
+
+std::optional<SkColor> ThemeService::GetUserColorSecondary() const {
+  const SkColor color =
+      profile_->GetPrefs()->GetInteger(prefs::kUserColorSecondary);
+  return color == SK_ColorTRANSPARENT ? std::nullopt
+                                      : std::make_optional(color);
+}
+
+std::optional<SkColor> ThemeService::GetUserColorAccent() const {
+  const SkColor color =
+      profile_->GetPrefs()->GetInteger(prefs::kUserColorAccent);
+  return color == SK_ColorTRANSPARENT ? std::nullopt
+                                      : std::make_optional(color);
+}
