+// When the user has picked independent exact primary/secondary/accent hex
+// colors (NBrowser custom theming), the normal Material/HCT tonal-ramp
+// mixers above only ever apply hue/chroma/tone-derived approximations of
+// those colors - never the literal picked SkColor - to any given surface,
+// and the underlying HCT conversion isn't a guaranteed bit-exact round trip
+// either. Users verifying with a pixel-exact tool (e.g. a Photoshop
+// eyedropper) need the literal hex to appear, unmodified, on the surfaces
+// that are visually "the browser's color". So directly overwrite just those
+// concrete ColorIds with the literal picked colors, added last so nothing
+// above can shadow it.
+void AddExactHexOverrideColorMixer(ui::ColorProvider* provider,
+                                   const ui::ColorProviderKey& key) {
+  if (key.user_color_source !=
+      ui::ColorProviderKey::UserColorSource::kExactHex) {
+    return;
+  }
+  CHECK(key.user_color.has_value());
+  CHECK(key.user_color_secondary.has_value());
+  CHECK(key.user_color_accent.has_value());
+  const SkColor primary = key.user_color.value();
+  const SkColor secondary = key.user_color_secondary.value();
+  const SkColor accent = key.user_color_accent.value();
+
+  ui::ColorMixer& mixer = provider->AddMixer();
+
+  // Primary: the "base" family that the active tab visually flows into -
+  // toolbar, active tab, NTP background. Stock Chromium groups these the
+  // same way (all read from kColorSysBase in material_tab_strip_color_mixer
+  // / material_chrome_color_mixer): the active tab is meant to look like a
+  // continuation of the toolbar below it, which is what reads as "selected".
+  // kColorNewTabPageBackground in particular gets re-derived by several
+  // later mixers (material NTP mixer, native Windows mixer), so it must be
+  // listed here explicitly rather than relying on it aliasing to
+  // kColorToolbar.
+  mixer[kColorToolbar] = {primary};
+  mixer[kColorTabBackgroundActiveFrameActive] = {primary};
+  mixer[kColorNewTabPageBackground] = {primary};
+  mixer[kColorNewTabPageActiveBackground] = {primary};
+
+  // Secondary: the "header" family - window frame and inactive tabs. Stock
+  // Chromium also groups these together (both read from kColorSysHeader),
+  // which is what makes an inactive tab visually recede into the frame
+  // instead of looking selected. Also used for the omnibox pill (meant to
+  // stand out from the toolbar as an interactive element) and generic
+  // popup/menu/bubble surfaces (context menus, the profile menu, Tab
+  // Search, page-info/download bubbles, etc. all read from these same few
+  // ColorIds, so covering them here fixes every such popup at once).
+  mixer[ui::kColorFrameActive] = {secondary};
+  mixer[ui::kColorFrameInactive] = {secondary};
+  mixer[kColorTabBackgroundInactiveFrameActive] = {secondary};
+  mixer[kColorLocationBarBackground] = {secondary};
+  mixer[ui::kColorMenuBackground] = {secondary};
+  mixer[ui::kColorBubbleBackground] = {secondary};
+  mixer[ui::kColorBubbleFooterBackground] = {secondary};
+
+  // Accent: links and prominent/interactive controls. Text/icons drawn on
+  // top of the accent-colored button use a plain black-or-white contrast
+  // pick (not HCT) so they stay legible without altering the accent color.
+  mixer[ui::kColorLinkForegroundDefault] = {accent};
+  mixer[ui::kColorButtonBackgroundProminent] = {accent};
+  mixer[ui::kColorButtonForegroundProminent] = {
+      color_utils::GetColorWithMaxContrast(accent)};
+  mixer[ui::kColorToggleButtonTrackOn] = {accent};
+
+  // Deliberately not touching tab text or the keyboard focus ring
+  // (kColorTabForeground*/kColorSysStateFocusRing*): stock Chromium keeps
+  // both neutral/on-surface-derived rather than tying them to a single
+  // theme color, and we're adapting the existing color roles, not
+  // redesigning which surfaces read from which role.
+}
+
 }  // namespace
 
