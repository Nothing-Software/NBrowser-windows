 #include "ui/color/dynamic_color/palette.h"
 #include "ui/gfx/color_palette.h"
@@ -136,6 +137,34 @@ struct Config {
   Transform neutral_variant;
 };
 
+// CAM16 (which Hct/TonalPalette(SkColor) is built on) is numerically unstable
+// near the achromatic axis: for colors very close to gray/black, tiny RGB
+// changes produce wildly different hue/chroma, and the chroma it reports is
+// often not actually close to 0 (this is the same root cause as the
+// SK_ColorBLACK "pink primary" issue worked around below in
+// AddRefColorMixer, see crbug.com/1457314 - it affects any near-gray color,
+// not just pure black). Detect near-gray colors directly from their RGB
+// channel spread instead of trusting CAM16's chroma for them, and force a
+// true zero-chroma (hue-independent) tonal palette so they render as
+// genuinely neutral grays rather than an arbitrarily tinted color.
+constexpr int kAchromaticChannelSpread = 8;
+
+bool IsNearAchromatic(SkColor color) {
+  const int r = SkColorGetR(color);
+  const int g = SkColorGetG(color);
+  const int b = SkColorGetB(color);
+  const int max_channel = std::max({r, g, b});
+  const int min_channel = std::min({r, g, b});
+  return (max_channel - min_channel) <= kAchromaticChannelSpread;
+}
+
+TonalPalette MakeExactTonalPalette(SkColor color) {
+  if (IsNearAchromatic(color)) {
+    return TonalPalette(/*hue=*/0.0, /*chroma=*/0.0);
+  }
+  return TonalPalette(color);
+}
+
 // Returns a `TonalPalette` constructed from `hue` transformed by `transform`.
 TonalPalette MakePalette(double hue, const Transform& transform) {
   CHECK_LE(hue, 360.0);
@@ -243,5 +272,36 @@ std::unique_ptr<Palette> GeneratePalette(SkColor seed_color,
   return FromConfig(seed_color, config);
 }
 
+std::unique_ptr<Palette> GeneratePaletteFromExactColors(SkColor primary,
+                                                         SkColor secondary,
+                                                         SkColor accent) {
+  // Neutral/neutral-variant derive their hue from primary below (used all
+  // over the UI - menu/bubble text, tab labels, borders, etc. via
+  // kColorSysOnSurface and friends). If primary itself is near-gray, force
+  // their chroma to 0 too: CAM16's hue for a near-gray primary is unreliable
+  // noise (see IsNearAchromatic above), and even the small Chroma(6.0/8.0)
+  // used for chromatic primaries is enough to visibly tint text/surfaces a
+  // color (e.g. reddish) across the whole browser when combined with that
+  // noise - a near-gray pick must produce fully neutral text, not a faint
+  // but pervasive tint.
+  const bool primary_is_achromatic = IsNearAchromatic(primary);
+  const double primary_hue =
+      primary_is_achromatic ? 0.0 : Hct(primary).get_hue();
+  const double neutral_chroma = primary_is_achromatic ? 0.0 : 6.0;
+  const double neutral_variant_chroma = primary_is_achromatic ? 0.0 : 8.0;
+
+  return std::make_unique<CustomPalette>(
+      // Built directly from the exact colors, preserving each color's real
+      // chroma instead of forcing a hardcoded nonzero chroma like
+      // MakePalette()/Config do - except for near-gray input, which is
+      // force-neutralized above since CAM16's chroma can't be trusted there.
+      MakeExactTonalPalette(primary), MakeExactTonalPalette(secondary),
+      MakeExactTonalPalette(accent),
+      // Neutral/neutral-variant stay hue-linked to primary (for coherence
+      // when primary is chromatic), same as the single-seed path.
+      MakePalette(primary_hue, Chroma(neutral_chroma)),
+      MakePalette(primary_hue, Chroma(neutral_variant_chroma)),
+      TonalPalette(25.0, 84.0));
+}
 
 }  // namespace ui
