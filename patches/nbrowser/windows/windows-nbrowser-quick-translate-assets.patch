diff --git a/chrome/installer/mini_installer/chrome.release b/chrome/installer/mini_installer/chrome.release
--- a/chrome/installer/mini_installer/chrome.release
+++ b/chrome/installer/mini_installer/chrome.release
@@ -106,6 +106,19 @@ WidevineCdm\_platform_specific\win_x64\widevinecdm.dll.sig: %(VersionDir)s\Widev
 WidevineCdm\_platform_specific\win_arm64\widevinecdm.dll: %(VersionDir)s\WidevineCdm\_platform_specific\win_arm64\
 WidevineCdm\_platform_specific\win_arm64\widevinecdm.dll.sig: %(VersionDir)s\WidevineCdm\_platform_specific\win_arm64\

+#
+# NBrowser: Quick Translate's vendored on-device TranslateKit engine + en-ru
+# language pack (see //nbrowser_translatekit and
+# chrome/browser/quick_translate/) - bundled the same way as WidevineCdm
+# above, since ungoogled-chromium's block-requests.patch disables the normal
+# component-updater download for this too.
+#
+TranslateKitFiles\libtranslatekit.dll: %(VersionDir)s\TranslateKitFiles\
+TranslateKitFiles\LanguagePacks\en_ru\en_ru_dictionary\*.*: %(VersionDir)s\TranslateKitFiles\LanguagePacks\en_ru\en_ru_dictionary\
+TranslateKitFiles\LanguagePacks\en_ru\en_ru_nmt\*.*: %(VersionDir)s\TranslateKitFiles\LanguagePacks\en_ru\en_ru_nmt\
+TranslateKitFiles\LanguagePacks\en_ru\ru_en_nmt\*.*: %(VersionDir)s\TranslateKitFiles\LanguagePacks\en_ru\ru_en_nmt\
+LanguageDetectionModel\model.tflite: %(VersionDir)s\LanguageDetectionModel\
+
