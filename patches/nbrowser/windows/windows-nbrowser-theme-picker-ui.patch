+// found in the LICENSE file.
+
+import '//resources/cr_elements/cr_icon_button/cr_icon_button.js';
+import './theme_color_swatch_field.js';
+
+import {I18nMixinLit} from '//resources/cr_elements/i18n_mixin_lit.js';
+import {EventTracker} from '//resources/js/event_tracker.js';
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+import type {SkColor} from '//resources/mojo/skia/public/mojom/skcolor.mojom-webui.js';
+
+import {getCss} from './theme_exact_hex_dialog.css.js';
+import {getHtml} from './theme_exact_hex_dialog.html.js';
+
+const EMPTY_SK_COLOR: SkColor = {
+  value: 0,
+};
+
+export interface ThemeExactHexDialogElement {
+  $: {
+    contentsWrapper: HTMLElement,
+    dialog: HTMLDialogElement,
+  };
+}
+
+const ThemeExactHexDialogElementBase = I18nMixinLit(CrLitElement);
+
+export class ThemeExactHexDialogElement extends
+    ThemeExactHexDialogElementBase {
+  static get is() {
+    return 'cr-theme-exact-hex-dialog';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      /* The currently committed exact colors, set by the host. */
+      primaryColor: {type: Object},
+      secondaryColor: {type: Object},
+      accentColor: {type: Object},
+
+      /* Which field's saturation/value + hue picker is open, if any. Only
+       * one is ever expanded at a time. */
+      expandedField_: {type: String, state: true},
+    };
+  }
+
+  accessor primaryColor: SkColor = EMPTY_SK_COLOR;
+  accessor secondaryColor: SkColor = EMPTY_SK_COLOR;
+  accessor accentColor: SkColor = EMPTY_SK_COLOR;
+
+  protected accessor expandedField_: 'primary'|'secondary'|'accent'|null =
+      null;
+
+  private eventTracker_: EventTracker = new EventTracker();
+
+  showAt(anchor: HTMLElement) {
+    this.$.dialog.showModal();
+
+    const anchorRect = anchor.getBoundingClientRect();
+    const dialogWidth = this.$.dialog.offsetWidth;
+    const dialogHeight = this.$.dialog.offsetHeight;
+    const margin = 8;
+
+    // Center horizontally on the anchor, then clamp so the dialog never
+    // runs off either edge of the (often narrow) side panel viewport.
+    const centeredLeft =
+        anchorRect.left + anchorRect.width / 2 - dialogWidth / 2;
+    const left = Math.min(
+        Math.max(centeredLeft, margin),
+        window.innerWidth - dialogWidth - margin);
+    this.$.dialog.style.left = `${left}px`;
+
+    // Always show below the anchor; only flip above it if there's truly no
+    // room below but there is room above.
+    let top = anchorRect.bottom;
+    if (top + dialogHeight > window.innerHeight - margin &&
+        anchorRect.top - dialogHeight >= margin) {
+      top = anchorRect.top - dialogHeight;
+    }
+    top = Math.min(
+        Math.max(top, margin), window.innerHeight - dialogHeight - margin);
+    this.$.dialog.style.top = `${top}px`;
+
+    this.eventTracker_.add(
+        this.$.dialog, 'pointerdown', this.onPointerdown_.bind(this));
+  }
+
+  hide() {
+    this.$.dialog.close();
+    this.eventTracker_.removeAll();
+    this.expandedField_ = null;
+  }
+
+  private onPointerdown_(e: PointerEvent) {
+    if (e.button !== 0 || e.composedPath()[0]! !== this.$.dialog) {
+      return;
+    }
+
+    this.hide();
+  }
+
+  protected onHideClick_() {
+    this.hide();
+  }
+
+  protected onPrimaryToggleExpanded_() {
+    this.expandedField_ =
+        this.expandedField_ === 'primary' ? null : 'primary';
+  }
+
+  protected onSecondaryToggleExpanded_() {
+    this.expandedField_ =
+        this.expandedField_ === 'secondary' ? null : 'secondary';
+  }
+
+  protected onAccentToggleExpanded_() {
+    this.expandedField_ = this.expandedField_ === 'accent' ? null : 'accent';
+  }
+
+  protected onPrimaryColorChanged_(e: CustomEvent<{color: SkColor}>) {
+    this.primaryColor = e.detail.color;
+    this.commit_();
+  }
+
+  protected onSecondaryColorChanged_(e: CustomEvent<{color: SkColor}>) {
+    this.secondaryColor = e.detail.color;
+    this.commit_();
+  }
+
+  protected onAccentColorChanged_(e: CustomEvent<{color: SkColor}>) {
+    this.accentColor = e.detail.color;
+    this.commit_();
+  }
+
+  /**
+   * Fires 'exact-hex-colors-changed' once all three colors are set. Each
+   * theme-color-swatch-field independently validates and parses its own
+   * hex/HSV input before firing 'color-changed', so by the time we get
+   * here every color received is already known-valid.
+   */
+  private commit_() {
+    if (this.primaryColor.value === 0 || this.secondaryColor.value === 0 ||
+        this.accentColor.value === 0) {
+      return;
+    }
+    this.fire('exact-hex-colors-changed', {
+      primary: this.primaryColor,
+      secondary: this.secondaryColor,
+      accent: this.accentColor,
+    });
+  }
+}
+
+customElements.define(
+    ThemeExactHexDialogElement.is, ThemeExactHexDialogElement);
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'cr-theme-exact-hex-dialog': ThemeExactHexDialogElement;
+  }
+}
