+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {ThemeColorSwatchFieldElement} from './theme_color_swatch_field.js';
+
+export function getHtml(this: ThemeColorSwatchFieldElement) {
+  // clang-format off
+  return html`
+<div id="row" @click="${this.onSwatchClick_}">
+  <div id="swatch" style="background-color: ${this.hex_}"></div>
+  <cr-input id="input"
+      label="${this.label}"
+      value="${this.hex_}"
+      placeholder="#000000"
+      pattern="^#?[0-9a-fA-F]{6}$"
+      ?invalid="${this.invalid_}"
+      error-message="${this.errorMessage}"
+      @change="${this.onHexChange_}"
+      @click="${this.onInputClick_}">
+  </cr-input>
+</div>
+<div id="picker" ?hidden="${!this.expanded}">
+  <div id="svArea" class="sv-area" style="--hue: ${this.hsv_.h}"
+      @pointerdown="${this.onSvPointerdown_}"
+      @pointermove="${this.onSvPointermove_}"
+      @pointerup="${this.onSvPointerup_}">
+    <div id="svHandle" class="sv-handle"
+        style="left: ${this.hsv_.s}%; top: ${100 - this.hsv_.v}%">
+    </div>
+  </div>
+  <cr-slider id="hueSlider" min="0" max="359" .value="${this.hsv_.h}"
+      .style="--knob-hue_: ${this.hsv_.h}"
+      @cr-slider-value-changed="${this.onCrSliderValueChanged_}"
+      @pointerup="${this.onHueSliderPointerup_}"
+      @keyup="${this.onHueSliderKeyup_}">
+  </cr-slider>
+</div>`;
+  // clang-format on
+}
diff --git a/ui/webui/resources/cr_components/theme_color_picker/theme_color_swatch_field.ts b/ui/webui/resources/cr_components/theme_color_picker/theme_color_swatch_field.ts
