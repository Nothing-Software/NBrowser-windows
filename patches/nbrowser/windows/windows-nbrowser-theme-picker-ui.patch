index 0000000000..059b1736ba
--- /dev/null
+++ b/ui/webui/resources/cr_components/theme_color_picker/theme_color_swatch_field.ts
@@ -0,0 +1,311 @@
+// Copyright 2024 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import '//resources/cr_elements/cr_input/cr_input.js';
+import '//resources/cr_elements/cr_slider/cr_slider.js';
+
+import type {CrInputElement} from '//resources/cr_elements/cr_input/cr_input.js';
+import type {CrSliderElement} from '//resources/cr_elements/cr_slider/cr_slider.js';
+import {hexColorToSkColor, skColorToHexColor} from '//resources/js/color_utils.js';
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+import type {PropertyValues} from '//resources/lit/v3_0/lit.rollup.js';
+import type {SkColor} from '//resources/mojo/skia/public/mojom/skcolor.mojom-webui.js';
+
+import {getCss} from './theme_color_swatch_field.css.js';
+import {getHtml} from './theme_color_swatch_field.html.js';
+
+const EMPTY_SK_COLOR: SkColor = {
+  value: 0,
+};
+
+interface Hsv {
+  h: number;  // 0-360
+  s: number;  // 0-100
+  v: number;  // 0-100
+}
+
+/** Lowercases and adds a leading '#' if missing, for hexColorToSkColor(). */
+function normalizeHex(hex: string): string {
+  const trimmed = hex.trim().toLowerCase();
+  return trimmed.startsWith('#') ? trimmed : `#${trimmed}`;
+}
+
+function rgbToHsv(r: number, g: number, b: number): Hsv {
+  r /= 255;
+  g /= 255;
+  b /= 255;
+  const max = Math.max(r, g, b);
+  const min = Math.min(r, g, b);
+  const delta = max - min;
+  let h = 0;
+  if (delta !== 0) {
+    if (max === r) {
+      h = ((g - b) / delta) % 6;
+    } else if (max === g) {
+      h = (b - r) / delta + 2;
+    } else {
+      h = (r - g) / delta + 4;
+    }
+    h *= 60;
+    if (h < 0) {
+      h += 360;
+    }
+  }
+  const s = max === 0 ? 0 : (delta / max) * 100;
+  const v = max * 100;
+  return {h, s, v};
+}
+
+function hsvToRgb(hsv: Hsv): {r: number, g: number, b: number} {
+  const s = hsv.s / 100;
+  const v = hsv.v / 100;
+  const c = v * s;
+  const x = c * (1 - Math.abs((hsv.h / 60) % 2 - 1));
+  const m = v - c;
+  let r = 0, g = 0, b = 0;
+  if (hsv.h < 60) {
+    r = c;
+    g = x;
+  } else if (hsv.h < 120) {
+    r = x;
+    g = c;
+  } else if (hsv.h < 180) {
+    g = c;
+    b = x;
+  } else if (hsv.h < 240) {
+    g = x;
+    b = c;
+  } else if (hsv.h < 300) {
+    r = x;
+    b = c;
+  } else {
+    r = c;
+    b = x;
+  }
+  return {
+    r: Math.round((r + m) * 255),
+    g: Math.round((g + m) * 255),
+    b: Math.round((b + m) * 255),
+  };
+}
+
+function skColorToHsv(color: SkColor): Hsv {
+  return rgbToHsv(
+      (color.value >> 16) & 0xff, (color.value >> 8) & 0xff,
+      color.value & 0xff);
+}
+
+function hsvToSkColor(hsv: Hsv): SkColor {
+  const {r, g, b} = hsvToRgb(hsv);
+  return {value: 0xff000000 + (r << 16) + (g << 8) + b};
+}
+
+function clamp(value: number, min: number, max: number): number {
+  return Math.min(max, Math.max(min, value));
+}
+
+export interface ThemeColorSwatchFieldElement {
+  $: {
+    input: CrInputElement,
+    svArea: HTMLElement,
+    hueSlider: CrSliderElement,
+  };
+}
+
+export class ThemeColorSwatchFieldElement extends CrLitElement {
+  static get is() {
+    return 'theme-color-swatch-field';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      label: {type: String},
+      errorMessage: {type: String},
+
+      /* The currently committed exact color, set by the host. */
+      color: {type: Object},
+
+      /* Whether the expandable saturation/value + hue picker is open.
+       * Controlled by the host so only one field's picker is ever open at
+       * once (see theme_exact_hex_dialog.ts). */
+      expanded: {type: Boolean},
+
+      /* The text currently shown in the hex field. */
+      hex_: {type: String, state: true},
+
+      /* Whether the field currently holds invalid hex text. */
+      invalid_: {type: Boolean, state: true},
+
+      /* The HSV breakdown of the current color, driving the picker UI. */
+      hsv_: {type: Object, state: true},
+    };
+  }
+
+  accessor label: string = '';
+  accessor errorMessage: string = '';
+  accessor color: SkColor = EMPTY_SK_COLOR;
+  accessor expanded: boolean = false;
+
+  protected accessor hex_: string = '';
+  protected accessor invalid_: boolean = false;
+  protected accessor hsv_: Hsv = {h: 0, s: 0, v: 0};
+
+  private draggingSv_: boolean = false;
+
+  // The value of the last color *this field itself* committed. Used to tell
+  // apart a genuinely external color change (e.g. dialog just opened, or a
+  // preset picked elsewhere) - which should resync hsv_ from the RGB color -
+  // from our own commit echoing back down through the host/browser. Skipping
+  // resync on our own echo matters because RGB->HSV is lossy: hue can't be
+  // recovered from a near-gray/white color (saturation near 0), so blindly
+  // reconstructing hsv_ from color on every update would snap hue back to 0
+  // right as the user drags away from white/gray.
+  private lastCommittedColorValue_: number = -1;
+
+  override willUpdate(changedProperties: PropertyValues<this>) {
+    super.willUpdate(changedProperties);
+
+    // Each commit() round-trips through the browser process asynchronously
+    // and comes back down as a fresh `color` push. While the picker is open
+    // and the user may already be several drags further along, a *stale*
+    // echo of an earlier commit can otherwise arrive out of order and stomp
+    // the in-progress local state (looks like the handle "fighting back" or
+    // getting stuck). So only resync hsv_/hex_ from `color` when the field
+    // isn't actively open for editing, or on the exact tick it's opened -
+    // never while the user is mid-session with the picker expanded.
+    const justOpened = changedProperties.has('expanded') && this.expanded;
+    const colorPushed = changedProperties.has('color') &&
+        this.color.value !== 0 &&
+        this.color.value !== this.lastCommittedColorValue_;
+    if (colorPushed && (!this.expanded || justOpened)) {
+      this.hex_ = skColorToHexColor(this.color);
+      this.invalid_ = false;
+      this.hsv_ = skColorToHsv(this.color);
+      // Keep the echo-filter in sync with what hex_/hsv_ now actually show.
+      // Without this, a field whose last *local* edit happened to produce
+      // the same value some *external* selection (a saved preset, another
+      // Chrome color) later pushes again would get skipped here as a false
+      // "own echo" - even though hex_/hsv_ had since moved on to reflect a
+      // different color picked in between. That showed up as saved presets
+      // opening with 1 or 2 fields silently stuck on a stale color instead
+      // of all 3 matching the preset, depending on which roles happened to
+      // collide with an earlier local edit.
+      this.lastCommittedColorValue_ = this.color.value;
+    }
+  }
+
+  protected onSwatchClick_() {
+    this.fire('toggle-expanded');
+  }
+
+  protected onInputClick_(e: Event) {
+    // Don't let clicking directly into the text field toggle the picker.
+    e.stopPropagation();
+  }
+
+  protected onHexChange_() {
+    this.hex_ = this.$.input.value;
+    this.commitHex_();
+  }
+
+  private commitHex_() {
+    const parsed = hexColorToSkColor(normalizeHex(this.hex_));
+    this.invalid_ = this.hex_.length > 0 && parsed.value === 0;
+    if (parsed.value === 0) {
+      return;
+    }
+    this.hsv_ = skColorToHsv(parsed);
+    this.commitColor_(parsed);
+  }
+
+  // Expensive: round-trips to the browser process and repaints the whole
+  // UI. Only ever call this on a committed user action (release, Enter,
+  // typed hex) - never on every drag tick.
+  private commitColor_(color: SkColor) {
+    this.lastCommittedColorValue_ = color.value;
+    this.color = color;
+    this.fire('color-changed', {color});
+  }
+
+  private commitHsv_(hsv: Hsv) {
+    this.hsv_ = hsv;
+    const color = hsvToSkColor(hsv);
+    this.hex_ = skColorToHexColor(color);
+    this.invalid_ = false;
+    this.commitColor_(color);
+  }
+
+  // Live drag preview only (cheap: local re-render of the gradient/handle
+  // position), no browser-wide commit.
+  private previewHsv_(hsv: Hsv) {
+    this.hsv_ = hsv;
+  }
+
+  protected onCrSliderValueChanged_() {
+    const h = this.$.hueSlider.value;
+    // At Value=0 the color is black regardless of hue/saturation - moving
+    // just the hue slider from a black (or fully white, Saturation=0)
+    // starting point would otherwise have no visible effect at all, look
+    // "stuck", and commit right back to the same color on release. Reveal a
+    // vivid color instead, matching how most color pickers behave when hue
+    // is touched from black/white.
+    const v = this.hsv_.v < 5 ? 100 : this.hsv_.v;
+    const s = this.hsv_.s < 5 && this.hsv_.v < 5 ? 100 : this.hsv_.s;
+    this.previewHsv_({h, s, v});
+  }
+
+  protected onHueSliderPointerup_() {
+    this.commitHsv_(this.hsv_);
+  }
+
+  protected onHueSliderKeyup_() {
+    this.commitHsv_(this.hsv_);
+  }
+
+  protected onSvPointerdown_(e: PointerEvent) {
+    if (e.button !== 0) {
+      return;
+    }
+    this.draggingSv_ = true;
+    this.$.svArea.setPointerCapture(e.pointerId);
+    this.previewHsv_(this.hsvFromEvent_(e));
+  }
+
+  protected onSvPointermove_(e: PointerEvent) {
+    if (!this.draggingSv_) {
+      return;
+    }
+    this.previewHsv_(this.hsvFromEvent_(e));
+  }
+
+  protected onSvPointerup_(e: PointerEvent) {
+    this.draggingSv_ = false;
+    this.$.svArea.releasePointerCapture(e.pointerId);
+    this.commitHsv_(this.hsvFromEvent_(e));
+  }
+
+  private hsvFromEvent_(e: PointerEvent): Hsv {
+    const rect = this.$.svArea.getBoundingClientRect();
+    const s = clamp((e.clientX - rect.left) / rect.width, 0, 1) * 100;
+    const v = 100 - clamp((e.clientY - rect.top) / rect.height, 0, 1) * 100;
+    return {...this.hsv_, s, v};
+  }
+}
+
+customElements.define(
+    ThemeColorSwatchFieldElement.is, ThemeColorSwatchFieldElement);
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'theme-color-swatch-field': ThemeColorSwatchFieldElement;
+  }
+}
