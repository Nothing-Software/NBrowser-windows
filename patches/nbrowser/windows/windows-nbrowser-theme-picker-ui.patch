+
+import type {ThemeExactHexDialogElement} from './theme_exact_hex_dialog.js';
+
+export function getHtml(this: ThemeExactHexDialogElement) {
+  // clang-format off
+  return html`
+<dialog id="dialog">
+  <div id="contentsWrapper">
+    <div id="header">
+      <h2 id="title">${this.i18n('hexColorDialogTitle')}</h2>
+      <slot name="headerSuffix"></slot>
+      <cr-icon-button id="close" class="icon-clear"
+          aria-label="${this.i18n('close')}"
+          title="${this.i18n('close')}"
+          @click="${this.onHideClick_}">
+      </cr-icon-button>
+    </div>
+    <theme-color-swatch-field
+        .label="${this.i18n('hexColorPrimaryLabel')}"
+        .errorMessage="${this.i18n('hexColorInvalidError')}"
+        .color="${this.primaryColor}"
+        ?expanded="${this.expandedField_ === 'primary'}"
+        @toggle-expanded="${this.onPrimaryToggleExpanded_}"
+        @color-changed="${this.onPrimaryColorChanged_}">
+    </theme-color-swatch-field>
+    <theme-color-swatch-field
+        .label="${this.i18n('hexColorSecondaryLabel')}"
+        .errorMessage="${this.i18n('hexColorInvalidError')}"
+        .color="${this.secondaryColor}"
+        ?expanded="${this.expandedField_ === 'secondary'}"
+        @toggle-expanded="${this.onSecondaryToggleExpanded_}"
+        @color-changed="${this.onSecondaryColorChanged_}">
+    </theme-color-swatch-field>
+    <theme-color-swatch-field
+        .label="${this.i18n('hexColorAccentLabel')}"
+        .errorMessage="${this.i18n('hexColorInvalidError')}"
+        .color="${this.accentColor}"
+        ?expanded="${this.expandedField_ === 'accent'}"
+        @toggle-expanded="${this.onAccentToggleExpanded_}"
+        @color-changed="${this.onAccentColorChanged_}">
+    </theme-color-swatch-field>
+  </div>
+</dialog>`;
+  // clang-format on
+}
