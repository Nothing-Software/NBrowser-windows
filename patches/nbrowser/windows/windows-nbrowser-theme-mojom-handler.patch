+void ThemeColorPickerHandler::SaveCurrentColorPreset() {
+  if (!theme_service_->GetIsExactHex()) {
+    return;
+  }
+  std::optional<SkColor> primary = theme_service_->GetUserColor();
+  std::optional<SkColor> secondary = theme_service_->GetUserColorSecondary();
+  std::optional<SkColor> accent = theme_service_->GetUserColorAccent();
+  if (!primary.has_value() || !secondary.has_value() ||
+      !accent.has_value()) {
+    return;
+  }
+
+  ScopedListPrefUpdate update(profile_->GetPrefs(),
+                              prefs::kSavedExactHexColorPresets);
+  const bool already_saved = std::ranges::any_of(
+      *update, [&](const base::Value& entry) {
+        if (!entry.is_dict()) {
+          return false;
+        }
+        const base::DictValue& dict = entry.GetDict();
+        return dict.FindInt("primary") == std::make_optional(
+                                               static_cast<int>(
+                                                   primary.value())) &&
+               dict.FindInt("secondary") ==
+                   std::make_optional(static_cast<int>(secondary.value())) &&
+               dict.FindInt("accent") ==
+                   std::make_optional(static_cast<int>(accent.value()));
+      });
+  if (already_saved) {
+    return;
+  }
+
+  base::DictValue preset;
+  preset.Set("primary", static_cast<int>(primary.value()));
+  preset.Set("secondary", static_cast<int>(secondary.value()));
+  preset.Set("accent", static_cast<int>(accent.value()));
+  update->Append(std::move(preset));
+}
+
+void ThemeColorPickerHandler::GetSavedColorPresets(
+    GetSavedColorPresetsCallback callback) {
+  std::vector<theme_color_picker::mojom::ColorPresetPtr> presets;
+  for (const base::Value& entry :
+       profile_->GetPrefs()->GetList(prefs::kSavedExactHexColorPresets)) {
+    if (!entry.is_dict()) {
+      continue;
+    }
+    const base::DictValue& dict = entry.GetDict();
+    std::optional<int> primary = dict.FindInt("primary");
+    std::optional<int> secondary = dict.FindInt("secondary");
+    std::optional<int> accent = dict.FindInt("accent");
+    if (!primary.has_value() || !secondary.has_value() ||
+        !accent.has_value()) {
+      continue;
+    }
+    auto preset = theme_color_picker::mojom::ColorPreset::New();
+    preset->primary = static_cast<SkColor>(primary.value());
+    preset->secondary = static_cast<SkColor>(secondary.value());
+    preset->accent = static_cast<SkColor>(accent.value());
+    presets.push_back(std::move(preset));
+  }
+  std::move(callback).Run(std::move(presets));
+}
+
+void ThemeColorPickerHandler::DeleteColorPreset(uint32_t index) {
+  ScopedListPrefUpdate update(profile_->GetPrefs(),
+                              prefs::kSavedExactHexColorPresets);
+  if (index >= update->size()) {
+    return;
+  }
+  update->erase(update->begin() + index);
+}
