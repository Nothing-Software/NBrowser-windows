 void ThemeColorPickerHandler::GetChromeColors(
     bool is_dark_mode,
     GetChromeColorsCallback callback) {
+  const base::ListValue& hidden_seeds =
+      profile_->GetPrefs()->GetList(prefs::kHiddenChromeColorSeeds);
   std::vector<theme_color_picker::mojom::ChromeColorPtr> colors;
   for (const auto& color_info : kDynamicCustomizeChromeColors) {
+    const int seed = static_cast<int>(color_info.color);
+    const bool is_hidden = std::ranges::any_of(
+        hidden_seeds, [seed](const base::Value& hidden_seed) {
+          return hidden_seed.GetIfInt() == std::make_optional(seed);
+        });
+    if (is_hidden) {
+      continue;
+    }
     colors.push_back(CreateDynamicChromeColor(color_info, is_dark_mode));
   }
   std::move(callback).Run(std::move(colors));
 }
 
+void ThemeColorPickerHandler::HideChromeColor(SkColor seed) {
+  ScopedListPrefUpdate update(profile_->GetPrefs(),
+                              prefs::kHiddenChromeColorSeeds);
+  const int seed_int = static_cast<int>(seed);
+  const bool already_hidden = std::ranges::any_of(
+      *update, [seed_int](const base::Value& hidden_seed) {
+        return hidden_seed.GetIfInt() == std::make_optional(seed_int);
+      });
+  if (!already_hidden) {
+    update->Append(seed_int);
+  }
+}
