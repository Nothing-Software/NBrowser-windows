+void RenderViewContextMenu::AppendQuickTranslateItem() {
+  if (!content_type_->SupportsGroup(
+          ContextMenuContentType::ITEM_GROUP_QUICK_TRANSLATE)) {
+    LOG(WARNING) << "QuickTranslate: item group not supported, skipping";
+    return;
+  }
+  // chrome://settings/languages, "Переводчик" section - the "Использовать
+  // Быстрый перевод" toggle.
+  if (!GetPrefs(browser_context_)
+           ->GetBoolean(quick_translate::prefs::kQuickTranslateEnabled)) {
+    return;
+  }
+  LOG(WARNING) << "QuickTranslate: adding menu item, id=" << kQuickTranslateMenuId;
+  // The live "SourceLang -> TargetLang" + translated-text preview is filled
+  // in asynchronously as an inline child view by RenderViewContextMenuViews
+  // (see chrome/browser/ui/views/renderer_context_menu/
+  // quick_translate_menu_view.h). The title here MUST stay empty:
+  // MenuItemView::IsContainer() (ui/views/controls/menu/menu_item_view.cc)
+  // only lets a row size itself around its child view's own preferred size
+  // (i.e. grow taller than one line) when the item has exactly one non-icon
+  // child AND an empty title - a non-empty title here would make the row
+  // paint its own single-line label UNDER/behind the child view instead.
+  menu_model_.AddItem(kQuickTranslateMenuId, std::u16string());
+}
