     WEB_APP_BLOCKED_MIGRATION_INFOBAR_DELEGATE = 134,
     OSCRYPTASYNC_AVAILABILITY_INFOBAR_DELEGATE = 135,
+    // NBrowser-specific identifier - not part of upstream Chromium, so not
+    // wired into the UMA enums.xml LINT.ThenChange this file otherwise
