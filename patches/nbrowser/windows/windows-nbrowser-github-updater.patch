+void AboutHandler::HandleSetUpdateAutoInstallEnabled(
+    const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  if (!args[0].is_bool()) {
+    LOG(ERROR) << "Can't parse setUpdateAutoInstallEnabled() args";
+    return;
+  }
+  g_browser_process->local_state()->SetBoolean(
+      chrome::startup::nbrowser_update::prefs::kUpdateAutoInstallEnabled,
+      args[0].GetBool());
+}
