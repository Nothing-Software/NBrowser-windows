   // below since these aren't owned by a subsystem.
   registry->RegisterBooleanPref("nbrowser.first_run_language_chosen", false);
   registry->RegisterBooleanPref("nbrowser.first_run_pending_relaunch", false);
+  // NBrowser GitHub Releases updater - see nbrowser_update_prefs.h. Stores
+  // the release tag the user dismissed the update infobar for, so it isn't
+  // re-shown until a newer release ships.
+  registry->RegisterStringPref("nbrowser.update_ignored_release_tag",
+                               std::string());
+  registry->RegisterBooleanPref("nbrowser.update_available_dot_visible",
+                                false);
 
